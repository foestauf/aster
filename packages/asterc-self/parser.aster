// expect-library
// The Aster parser, shared by parse.aster and the type checker. It defines the syntax tree (`Item`, `Expr`, `Stmt`,
// `TypeExpr`, `Pattern`, `Block`, `Ident` and the structs around them, each spanned with byte offsets) and a recursive
// descent parser over the lexer's tokens. `new_parser` builds a Parser from a Lexer (`new_parser_at` also offsets every
// span by a file's global base) and `parse_program` turns it into the items of a file, recording syntax errors in
// `Parser.errors`. It is a recursive-descent parser; the goldens in tests/golden/
// and the self-host fixed point check it.

import "lexer.aster";

// ---- syntax tree. Each node that has a span is a struct holding `start`, `end` and an enum `node`, so a span can be
// read without matching on the kind.

struct Ident {
    name: string,
    start: int,
    end: int,
}

struct TypeExpr {
    start: int,
    end: int,
    node: TypeNode,
}

enum TypeNode {
    Named(string, [TypeExpr]),
    Array(TypeExpr),
}

// A parameter or a struct field.
struct Typed {
    name: Ident,
    ty: TypeExpr,
}

struct VariantDecl {
    name: Ident,
    payload: [TypeExpr],
}

struct FnDecl {
    start: int,
    end: int,
    name: Ident,
    params: [Typed],
    ret: Option[TypeExpr],
    body: Block,
}

struct StructDecl {
    start: int,
    end: int,
    name: Ident,
    fields: [Typed],
}

struct EnumDecl {
    start: int,
    end: int,
    name: Ident,
    params: [Ident],
    variants: [VariantDecl],
}

struct ImportDecl {
    start: int,
    end: int,
    path_start: int,
    path_end: int,
}

enum Item {
    Fn(FnDecl),
    Struct(StructDecl),
    Enum(EnumDecl),
    Import(ImportDecl),
}

struct Block {
    start: int,
    end: int,
    stmts: [Stmt],
}

struct Stmt {
    start: int,
    end: int,
    node: StmtNode,
}

// `Let` is true for `var`. `Match` holds the keyword as an Ident for its span. `LetElse` holds the pattern, the
// initializer, the `else` keyword as an Ident and the else block; `IfLet` the pattern, the scrutinee, the then block and
// the else branch (`Else::IfLet` holds a nested `StmtNode::IfLet` statement, `Else::If` a nested `StmtNode::If`).
enum StmtNode {
    Let(bool, Ident, TypeExpr, Expr),
    LetElse(Pattern, Expr, Ident, Block),
    Assign(string, Expr, Expr),
    If(Expr, Block, Else),
    IfLet(Pattern, Expr, Block, Else),
    While(Expr, Block),
    ForRange(Ident, Expr, Expr, Block),
    ForEach(Ident, Expr, Block),
    Match(Ident, Expr, [Arm]),
    Break,
    Continue,
    Return(Option[Expr]),
    Block(Block),
    Expr(Expr),
}

enum Else {
    None,
    Block(Block),
    If(Stmt),
    IfLet(Stmt),
}

struct Expr {
    start: int,
    end: int,
    node: ExprNode,
}

// `Int` holds the canonical decimal value, and `Char` and `Str` the literal's source text, quotes included. `EmptyMap` is
// the empty map or set literal `{}`.
enum ExprNode {
    Int(string),
    Char(string),
    Str(string),
    Bool(bool),
    Name(string),
    Unary(string, Expr),
    Binary(string, Expr, Expr),
    Call(Expr, [Expr]),
    If(Expr, Expr, Expr),
    Field(Expr, Ident),
    StructLit(Ident, [FieldInit]),
    Index(Expr, Expr),
    Try(Expr),
    ArrayLit([Expr]),
    Variant(Ident, Ident, [Expr]),
    Match(Ident, Expr, [Arm]),
    EmptyMap,
}

struct FieldInit {
    name: Ident,
    value: Expr,
}

struct Pattern {
    start: int,
    end: int,
    node: PatternNode,
}

// An `Or` holds two or more alternatives, none of them `Wildcard` or `Or`. The literal patterns hold their source text,
// with a negative integer's `-` joined to its digits.
enum PatternNode {
    Wildcard,
    Variant(Ident, Ident, [Binder]),
    Or([Pattern]),
    IntPat(string),
    CharPat(string),
    StringPat(string),
    BoolPat(bool),
}

enum Binder {
    Wild,
    Named(Ident),
}

struct Arm {
    pattern: Pattern,
    body: ArmBody,
}

enum ArmBody {
    Block(Block),
    Expr(Expr),
}

// ---- parser. Recursive descent, function by function. The original TypeScript parser threw on a
// syntax error and catches at statement and item boundaries. Aster has no exceptions, so a function that can fail
// returns an Option: `fail` records the error and the function returns `Option::None`, which every caller passes up
// with `?`. parse_block and parse_program match on the Option and resynchronise on `None`.

struct Parser {
    src: string,
    tokens: [Token],
    pos: int,
    errors: [LexError],
    // True while parsing an `if`/`while`/`for`/`match` header, where `Name {` starts the body, not a struct literal.
    no_struct_lit: bool,
    // Added to every token's offsets (see new_parser_at), so spans are global; `text` subtracts it to index `src`.
    base: int,
}

fn peek_at(p: Parser, offset: int): Token {
    return p.tokens[min(p.pos + offset, len(p.tokens) - 1)];
}

fn peek(p: Parser): Token {
    return peek_at(p, 0);
}

fn previous(p: Parser): Token {
    if p.pos > 0 {
        return p.tokens[p.pos - 1];
    }
    return p.tokens[0];
}

fn at(p: Parser, kind: string): bool {
    return peek(p).kind == kind;
}

fn advance(p: Parser): Token {
    let t: Token = peek(p);
    if t.kind != "eof" {
        p.pos += 1;
    }
    return t;
}

fn eat(p: Parser, kind: string): bool {
    if at(p, kind) {
        advance(p);
        return true;
    }
    return false;
}

fn at_item(p: Parser): bool {
    return at(p, "fn") || at(p, "struct") || at(p, "enum") || at(p, "import");
}

fn text(p: Parser, t: Token): string {
    return substring(p.src, t.start - p.base, t.end - p.base);
}

fn ident_of(p: Parser, t: Token): Ident {
    return Ident { name: text(p, t), start: t.start, end: t.end };
}

// How a token is named in error messages.
fn describe(p: Parser, t: Token): string {
    return match t.kind {
        "eof" => "end of file",
        "ident" => "identifier '" + text(p, t) + "'",
        "int" => "integer '" + text(p, t) + "'",
        "string" => "string literal",
        "char" => "character literal",
        _ => "'" + text(p, t) + "'",
    };
}

fn error_at(p: Parser, message: string, start: int, end: int) {
    push(p.errors, LexError { start: start, end: end, message: message });
}

fn fail(p: Parser, message: string, t: Token) {
    error_at(p, message, t.start, t.end);
}

// Consumes a token of `kind`, or fails.
fn expect(p: Parser, kind: string): Option[Token] {
    if at(p, kind) {
        return Option::Some(advance(p));
    }
    var what: string = "'" + kind + "'";
    if kind == "ident" {
        what = "identifier";
    } else if kind == "string" {
        what = "string literal";
    }
    let t: Token = peek(p);
    fail(p, "expected " + what + ", found " + describe(p, t), t);
    return Option::None;
}

// Integer literal digits without leading zeros, keeping a lone `0`.
fn canonical_digits(s: string): string {
    var i: int = 0;
    while i < len(s) - 1 && byte_at(s, i) == '0' {
        i += 1;
    }
    return substring(s, i, len(s));
}

// Whether canonical `digits` fit in an int, as a magnitude: up to 2^63 - 1, or 2^63 when negated. Aster has no wider
// integer and no string ordering, so this compares lengths, then bytes.
fn fits(digits: string, negative: bool): bool {
    var limit: string = "9223372036854775807";
    if negative {
        limit = "9223372036854775808";
    }
    if len(digits) != len(limit) {
        return len(digits) < len(limit);
    }
    for i in 0..len(digits) {
        let a: int = byte_at(digits, i);
        let b: int = byte_at(limit, i);
        if a != b {
            return a < b;
        }
    }
    return true;
}

// ---- declarations

fn parse_program(p: Parser): [Item] {
    let items: [Item] = [];
    while !at(p, "eof") {
        if !at_item(p) {
            let t: Token = peek(p);
            error_at(p, "expected 'fn', 'struct', 'enum' or 'import', found " + describe(p, t), t.start, t.end);
            sync_to_item(p);
            continue;
        }
        let item: Option[Item] = if at(p, "fn") {
            parse_function(p)
        } else if at(p, "struct") {
            parse_struct(p)
        } else if at(p, "enum") {
            parse_enum(p)
        } else {
            parse_import(p)
        };
        match item {
            Option::Some(i) => push(items, i),
            Option::None => sync_to_item(p),
        }
    }
    return items;
}

// Skips to the next `fn`, `struct`, `enum`, `import` or EOF. Consumes at least one token unless already at an item.
fn sync_to_item(p: Parser) {
    if !at_item(p) {
        advance(p);
    }
    while !at_item(p) && !at(p, "eof") {
        advance(p);
    }
}

fn parse_function(p: Parser): Option[Item] {
    let kw: Token = expect(p, "fn")?;
    let name: Token = expect(p, "ident")?;
    expect(p, "(")?;
    let params: [Typed] = [];
    if !at(p, ")") {
        var more: bool = true;
        while more {
            let param: Token = expect(p, "ident")?;
            expect(p, ":")?;
            let ty: TypeExpr = parse_type(p)?;
            push(params, Typed { name: ident_of(p, param), ty: ty });
            more = eat(p, ",");
        }
    }
    expect(p, ")")?;
    var ret: Option[TypeExpr] = Option::None;
    if eat(p, ":") {
        ret = Option::Some(parse_type(p)?);
    }
    let body: Block = parse_block(p)?;
    return Option::Some(Item::Fn(FnDecl { start: kw.start, end: body.end, name: ident_of(p, name), params: params, ret: ret, body: body }));
}

fn parse_struct(p: Parser): Option[Item] {
    let kw: Token = expect(p, "struct")?;
    let name: Token = expect(p, "ident")?;
    expect(p, "{")?;
    let fields: [Typed] = [];
    while !at(p, "}") {
        let field: Token = expect(p, "ident")?;
        expect(p, ":")?;
        let ty: TypeExpr = parse_type(p)?;
        push(fields, Typed { name: ident_of(p, field), ty: ty });
        if !eat(p, ",") {
            break;
        }
    }
    let close: Token = expect(p, "}")?;
    return Option::Some(Item::Struct(StructDecl { start: kw.start, end: close.end, name: ident_of(p, name), fields: fields }));
}

// `enum Name { V, W(T, U), }`: at least one variant; payload lists take no trailing comma.
fn parse_enum(p: Parser): Option[Item] {
    let kw: Token = expect(p, "enum")?;
    let name: Token = expect(p, "ident")?;
    let params: [Ident] = [];
    if eat(p, "[") {
        var more_params: bool = true;
        while more_params {
            let param: Token = expect(p, "ident")?;
            push(params, ident_of(p, param));
            more_params = eat(p, ",");
        }
        expect(p, "]")?;
    }
    expect(p, "{")?;
    let variants: [VariantDecl] = [];
    while true {
        let variant: Token = expect(p, "ident")?;
        let payload: [TypeExpr] = [];
        if eat(p, "(") {
            var more: bool = true;
            while more {
                let ty: TypeExpr = parse_type(p)?;
                push(payload, ty);
                more = eat(p, ",");
            }
            expect(p, ")")?;
        }
        push(variants, VariantDecl { name: ident_of(p, variant), payload: payload });
        if !eat(p, ",") || at(p, "}") {
            break;
        }
    }
    let close: Token = expect(p, "}")?;
    return Option::Some(Item::Enum(EnumDecl { start: kw.start, end: close.end, name: ident_of(p, name), params: params, variants: variants }));
}

// `import "path";`
fn parse_import(p: Parser): Option[Item] {
    let kw: Token = expect(p, "import")?;
    let path: Token = expect(p, "string")?;
    let semi: Token = expect(p, ";")?;
    return Option::Some(Item::Import(ImportDecl { start: kw.start, end: semi.end, path_start: path.start, path_end: path.end }));
}

fn parse_type(p: Parser): Option[TypeExpr] {
    if at(p, "[") {
        let open: Token = advance(p);
        let elem: TypeExpr = parse_type(p)?;
        let close: Token = expect(p, "]")?;
        return Option::Some(TypeExpr { start: open.start, end: close.end, node: TypeNode::Array(elem) });
    }
    let t: Token = expect(p, "ident")?;
    let args: [TypeExpr] = [];
    if !eat(p, "[") {
        return Option::Some(TypeExpr { start: t.start, end: t.end, node: TypeNode::Named(text(p, t), args) });
    }
    var more: bool = true;
    while more {
        let arg: TypeExpr = parse_type(p)?;
        push(args, arg);
        more = eat(p, ",");
    }
    let close: Token = expect(p, "]")?;
    return Option::Some(TypeExpr { start: t.start, end: close.end, node: TypeNode::Named(text(p, t), args) });
}

// ---- statements

fn parse_block(p: Parser): Option[Block] {
    let open: Token = expect(p, "{")?;
    let stmts: [Stmt] = [];
    while !at(p, "}") && !at(p, "eof") && !at_item(p) {
        match parse_statement(p) {
            Option::Some(s) => push(stmts, s),
            Option::None => sync_statement(p),
        }
    }
    let close: Token = expect(p, "}")?;
    return Option::Some(Block { start: open.start, end: close.end, stmts: stmts });
}

// Skips past the next `;`, or up to (not past) a `}`, `fn`, `struct`, `enum`, `match` or EOF.
fn sync_statement(p: Parser) {
    while !at(p, "eof") && !at(p, "}") && !at_item(p) && !at(p, "match") {
        if advance(p).kind == ";" {
            return;
        }
    }
}

// After `let`: does a pattern follow (rather than `name: type`)?
fn at_pattern_let(p: Parser): bool {
    let k: string = peek_at(p, 1).kind;
    if k == "ident" {
        return peek_at(p, 2).kind == "::";
    }
    if k == "-" {
        return peek_at(p, 2).kind == "int";
    }
    return k == "int" || k == "char" || k == "string" || k == "true" || k == "false";
}

fn parse_statement(p: Parser): Option[Stmt] {
    let t: Token = peek(p);
    let k: string = t.kind;
    match k {
        "let" | "var" => {
            if k == "let" && at_pattern_let(p) {
                advance(p);
                let pattern: Pattern = parse_pattern(p)?;
                expect(p, "=")?;
                let init: Expr = parse_header_expr(p)?;
                let kw: Token = expect(p, "else")?;
                let else_block: Block = parse_block(p)?;
                let semi: Token = expect(p, ";")?;
                return Option::Some(Stmt { start: t.start, end: semi.end, node: StmtNode::LetElse(pattern, init, ident_of(p, kw), else_block) });
            }
            advance(p);
            let name: Token = expect(p, "ident")?;
            expect(p, ":")?;
            let ty: TypeExpr = parse_type(p)?;
            expect(p, "=")?;
            let init: Expr = parse_expr(p)?;
            let semi: Token = expect(p, ";")?;
            return Option::Some(Stmt { start: t.start, end: semi.end, node: StmtNode::Let(k == "var", ident_of(p, name), ty, init) });
        }
        "match" => {
            return parse_match_stmt(p);
        }
        "if" => {
            return parse_if_stmt(p);
        }
        "for" => {
            return parse_for(p);
        }
        "while" => {
            advance(p);
            let cond: Expr = parse_header_expr(p)?;
            let body: Block = parse_block(p)?;
            return Option::Some(Stmt { start: t.start, end: body.end, node: StmtNode::While(cond, body) });
        }
        "break" | "continue" => {
            advance(p);
            let semi: Token = expect(p, ";")?;
            let node: StmtNode = match k { "break" => StmtNode::Break, _ => StmtNode::Continue };
            return Option::Some(Stmt { start: t.start, end: semi.end, node: node });
        }
        "return" => {
            advance(p);
            var value: Option[Expr] = Option::None;
            if !at(p, ";") {
                value = Option::Some(parse_expr(p)?);
            }
            let semi: Token = expect(p, ";")?;
            return Option::Some(Stmt { start: t.start, end: semi.end, node: StmtNode::Return(value) });
        }
        "{" => {
            let b: Block = parse_block(p)?;
            return Option::Some(Stmt { start: b.start, end: b.end, node: StmtNode::Block(b) });
        }
        _ => {
            return parse_simple_statement(p);
        }
    }
}

fn is_assign_op(k: string): bool {
    return match k { "=" | "+=" | "-=" | "*=" | "/=" | "%=" => true, _ => false };
}

// An assignment `place op= e;` or an expression statement `e;`.
fn parse_simple_statement(p: Parser): Option[Stmt] {
    let e: Expr = parse_expr(p)?;
    let op: string = peek(p).kind;
    if is_assign_op(op) {
        advance(p);
        let value: Expr = parse_expr(p)?;
        let semi: Token = expect(p, ";")?;
        return Option::Some(Stmt { start: e.start, end: semi.end, node: StmtNode::Assign(op, e, value) });
    }
    let semi: Token = expect(p, ";")?;
    return Option::Some(Stmt { start: e.start, end: semi.end, node: StmtNode::Expr(e) });
}

fn parse_for(p: Parser): Option[Stmt] {
    let kw: Token = expect(p, "for")?;
    let name: Token = expect(p, "ident")?;
    expect(p, "in")?;
    let first: Expr = parse_header_expr(p)?;
    if eat(p, "..") {
        let end: Expr = parse_header_expr(p)?;
        let body: Block = parse_block(p)?;
        return Option::Some(Stmt { start: kw.start, end: body.end, node: StmtNode::ForRange(ident_of(p, name), first, end, body) });
    }
    let body: Block = parse_block(p)?;
    return Option::Some(Stmt { start: kw.start, end: body.end, node: StmtNode::ForEach(ident_of(p, name), first, body) });
}

fn parse_if_stmt(p: Parser): Option[Stmt] {
    let kw: Token = expect(p, "if")?;
    if eat(p, "let") {
        let pattern: Pattern = parse_pattern(p)?;
        expect(p, "=")?;
        let scrutinee: Expr = parse_header_expr(p)?;
        let then: Block = parse_block(p)?;
        let els: Else = parse_else(p)?;
        return Option::Some(Stmt { start: kw.start, end: if_end(then, els), node: StmtNode::IfLet(pattern, scrutinee, then, els) });
    }
    let cond: Expr = parse_header_expr(p)?;
    let then: Block = parse_block(p)?;
    let els: Else = parse_else(p)?;
    return Option::Some(Stmt { start: kw.start, end: if_end(then, els), node: StmtNode::If(cond, then, els) });
}

// An if statement's optional `else` branch: a block, or a chained `if` or `if let`.
fn parse_else(p: Parser): Option[Else] {
    if !eat(p, "else") {
        return Option::Some(Else::None);
    }
    if !at(p, "if") {
        return Option::Some(Else::Block(parse_block(p)?));
    }
    let s: Stmt = parse_if_stmt(p)?;
    if let StmtNode::IfLet(_, _, _, _) = s.node {
        return Option::Some(Else::IfLet(s));
    }
    return Option::Some(Else::If(s));
}

// Where an if statement with the block `then` and the else branch `els` ends.
fn if_end(then: Block, els: Else): int {
    return match els {
        Else::None => then.end,
        Else::Block(b) => b.end,
        Else::If(s) => s.end,
        Else::IfLet(s) => s.end,
    };
}

// Arms are `pattern => block [,]` or `pattern => expr ,`; the comma after the last expression arm is optional.
fn parse_match_stmt(p: Parser): Option[Stmt] {
    let kw: Token = expect(p, "match")?;
    let scrutinee: Expr = parse_header_expr(p)?;
    expect(p, "{")?;
    let arms: [Arm] = [];
    while !at(p, "}") && !at(p, "eof") {
        let pattern: Pattern = parse_pattern(p)?;
        expect(p, "=>")?;
        if at(p, "{") {
            let b: Block = parse_block(p)?;
            push(arms, Arm { pattern: pattern, body: ArmBody::Block(b) });
            eat(p, ",");
        } else {
            let e: Expr = parse_expr_with_struct_lits(p)?;
            push(arms, Arm { pattern: pattern, body: ArmBody::Expr(e) });
            if !eat(p, ",") {
                break;
            }
        }
    }
    let close: Token = expect(p, "}")?;
    return Option::Some(Stmt { start: kw.start, end: close.end, node: StmtNode::Match(ident_of(p, kw), scrutinee, arms) });
}

// `_`, or one or more alternatives separated by `|`.
fn parse_pattern(p: Parser): Option[Pattern] {
    if at(p, "_") {
        let w: Token = advance(p);
        return Option::Some(Pattern { start: w.start, end: w.end, node: PatternNode::Wildcard });
    }
    let first: Pattern = parse_alternative(p)?;
    let alternatives: [Pattern] = [first];
    while eat(p, "|") {
        let alt: Pattern = parse_alternative(p)?;
        push(alternatives, alt);
    }
    if len(alternatives) == 1 {
        return Option::Some(first);
    }
    let last: Pattern = alternatives[len(alternatives) - 1];
    return Option::Some(Pattern { start: first.start, end: last.end, node: PatternNode::Or(alternatives) });
}

// A literal (an integer, optionally negated, a character, a string, `true` or `false`) or an enum variant.
fn parse_alternative(p: Parser): Option[Pattern] {
    let t: Token = peek(p);
    let k: string = t.kind;
    match k {
        "int" => {
            advance(p);
            if !fits(canonical_digits(text(p, t)), false) {
                error_at(p, "integer literal out of range", t.start, t.end);
            }
            return Option::Some(Pattern { start: t.start, end: t.end, node: PatternNode::IntPat(text(p, t)) });
        }
        "-" => {
            advance(p);
            let literal: Token = expect(p, "int")?;
            if !fits(canonical_digits(text(p, literal)), true) {
                error_at(p, "integer literal out of range", t.start, literal.end);
            }
            return Option::Some(Pattern { start: t.start, end: literal.end, node: PatternNode::IntPat("-" + text(p, literal)) });
        }
        "char" => {
            advance(p);
            return Option::Some(Pattern { start: t.start, end: t.end, node: PatternNode::CharPat(text(p, t)) });
        }
        "string" => {
            advance(p);
            return Option::Some(Pattern { start: t.start, end: t.end, node: PatternNode::StringPat(text(p, t)) });
        }
        "true" | "false" => {
            advance(p);
            return Option::Some(Pattern { start: t.start, end: t.end, node: PatternNode::BoolPat(k == "true") });
        }
        "ident" => {
            return parse_variant_pattern(p);
        }
        _ => {
            fail(p, "expected pattern, found " + describe(p, t), t);
            return Option::None;
        }
    }
}

// `Enum::Variant`, with an optional parenthesised list of binders.
fn parse_variant_pattern(p: Parser): Option[Pattern] {
    let enum_name: Token = expect(p, "ident")?;
    expect(p, "::")?;
    let variant: Token = expect(p, "ident")?;
    let binders: [Binder] = [];
    var end: int = variant.end;
    if eat(p, "(") {
        var more: bool = true;
        while more {
            if eat(p, "_") {
                push(binders, Binder::Wild);
            } else {
                let name: Token = expect(p, "ident")?;
                push(binders, Binder::Named(ident_of(p, name)));
            }
            more = eat(p, ",");
        }
        let close: Token = expect(p, ")")?;
        end = close.end;
    }
    return Option::Some(Pattern { start: enum_name.start, end: end, node: PatternNode::Variant(ident_of(p, enum_name), ident_of(p, variant), binders) });
}

// ---- expressions

fn parse_expr(p: Parser): Option[Expr] {
    return parse_binary(p, 0);
}

// The TypeScript parser's withStructLits(false, parseExpr). The flag is restored before the caller sees a failure,
// which is what the TypeScript `finally` does.
fn parse_header_expr(p: Parser): Option[Expr] {
    let saved: bool = p.no_struct_lit;
    p.no_struct_lit = true;
    let e: Option[Expr] = parse_expr(p);
    p.no_struct_lit = saved;
    return e;
}

// withStructLits(true, parseExpr).
fn parse_expr_with_struct_lits(p: Parser): Option[Expr] {
    let saved: bool = p.no_struct_lit;
    p.no_struct_lit = false;
    let e: Option[Expr] = parse_expr(p);
    p.no_struct_lit = saved;
    return e;
}

// Binary operator levels, loosest first.
fn level_ops(level: int): [string] {
    return match level {
        0 => ["||"],
        1 => ["&&"],
        2 => ["==", "!="],
        3 => ["<", "<=", ">", ">="],
        4 => ["+", "-"],
        5 => ["*", "/", "%"],
        _ => [],
    };
}

// Comparisons (levels 2 and 3) do not chain.
fn level_chainable(level: int): bool {
    return match level { 2 | 3 => false, _ => true };
}

fn contains(words: [string], w: string): bool {
    for x in words {
        if x == w {
            return true;
        }
    }
    return false;
}

fn parse_binary(p: Parser, level: int): Option[Expr] {
    if level == 6 {
        return parse_unary(p);
    }
    let ops: [string] = level_ops(level);
    var left: Expr = parse_binary(p, level + 1)?;
    while contains(ops, peek(p).kind) {
        let op: string = advance(p).kind;
        let right: Expr = parse_binary(p, level + 1)?;
        left = Expr { start: left.start, end: right.end, node: ExprNode::Binary(op, left, right) };
        if !level_chainable(level) && contains(ops, peek(p).kind) {
            fail(p, "comparison operators cannot be chained", peek(p));
            return Option::None;
        }
    }
    return Option::Some(left);
}

fn parse_unary(p: Parser): Option[Expr] {
    let t: Token = peek(p);
    if t.kind != "-" && t.kind != "!" {
        return parse_postfix(p);
    }
    advance(p);
    if t.kind == "-" && at(p, "int") {
        // Folding here is what lets -9223372036854775808 be written as a literal.
        let literal: Token = advance(p);
        let digits: string = canonical_digits(text(p, literal));
        if !fits(digits, true) {
            error_at(p, "integer literal out of range", t.start, literal.end);
        }
        var value: string = digits;
        if digits != "0" {
            value = "-" + digits;
        }
        return Option::Some(Expr { start: t.start, end: literal.end, node: ExprNode::Int(value) });
    }
    let operand: Expr = parse_unary(p)?;
    return Option::Some(Expr { start: t.start, end: operand.end, node: ExprNode::Unary(t.kind, operand) });
}

// Comma-separated expressions with struct literals allowed, up to (not including) the closing token. With
// `allow_empty`, an immediately closing token yields no expressions; `trailing` allows a comma before it.
fn parse_expr_list(p: Parser, close: string, allow_empty: bool, trailing: bool): Option[[Expr]] {
    let saved: bool = p.no_struct_lit;
    p.no_struct_lit = false;
    let exprs: Option[[Expr]] = parse_exprs(p, close, allow_empty, trailing);
    p.no_struct_lit = saved;
    return exprs;
}

// parse_expr_list's loop, split out so that `?` can leave it while the caller still restores the flag.
fn parse_exprs(p: Parser, close: string, allow_empty: bool, trailing: bool): Option[[Expr]] {
    let exprs: [Expr] = [];
    if allow_empty && at(p, close) {
        return Option::Some(exprs);
    }
    while true {
        let e: Expr = parse_expr(p)?;
        push(exprs, e);
        if !eat(p, ",") || (trailing && at(p, close)) {
            break;
        }
    }
    return Option::Some(exprs);
}

fn parse_postfix(p: Parser): Option[Expr] {
    var e: Expr = parse_primary(p)?;
    while true {
        if eat(p, "(") {
            let args: [Expr] = parse_expr_list(p, ")", true, false)?;
            let close: Token = expect(p, ")")?;
            e = Expr { start: e.start, end: close.end, node: ExprNode::Call(e, args) };
        } else if eat(p, ".") {
            let field: Token = expect(p, "ident")?;
            e = Expr { start: e.start, end: field.end, node: ExprNode::Field(e, ident_of(p, field)) };
        } else if eat(p, "[") {
            let index: Expr = parse_expr_with_struct_lits(p)?;
            let close: Token = expect(p, "]")?;
            e = Expr { start: e.start, end: close.end, node: ExprNode::Index(e, index) };
        } else if at(p, "?") {
            let q: Token = advance(p);
            e = Expr { start: e.start, end: q.end, node: ExprNode::Try(e) };
        } else {
            return Option::Some(e);
        }
    }
}

fn parse_primary(p: Parser): Option[Expr] {
    let t: Token = peek(p);
    let k: string = t.kind;
    match k {
        "int" => {
            advance(p);
            let digits: string = canonical_digits(text(p, t));
            if !fits(digits, false) {
                error_at(p, "integer literal out of range", t.start, t.end);
            }
            return Option::Some(Expr { start: t.start, end: t.end, node: ExprNode::Int(digits) });
        }
        "char" => {
            advance(p);
            return Option::Some(Expr { start: t.start, end: t.end, node: ExprNode::Char(text(p, t)) });
        }
        "string" => {
            advance(p);
            return Option::Some(Expr { start: t.start, end: t.end, node: ExprNode::Str(text(p, t)) });
        }
        "true" | "false" => {
            advance(p);
            return Option::Some(Expr { start: t.start, end: t.end, node: ExprNode::Bool(k == "true") });
        }
        "ident" => {
            advance(p);
            if at(p, "::") {
                return parse_variant_expr(p, t);
            }
            if at(p, "{") && !p.no_struct_lit {
                return parse_struct_lit(p, t);
            }
            return Option::Some(Expr { start: t.start, end: t.end, node: ExprNode::Name(text(p, t)) });
        }
        "[" => {
            advance(p);
            // The TypeScript loop is `while (!at(']'))`, so `[` at EOF reports a missing expression, as here.
            let elements: [Expr] = parse_expr_list(p, "]", true, true)?;
            let close: Token = expect(p, "]")?;
            return Option::Some(Expr { start: t.start, end: close.end, node: ExprNode::ArrayLit(elements) });
        }
        "{" => {
            // In expression position, `{` can only start the empty map or set literal `{}`.
            advance(p);
            let close: Token = expect(p, "}")?;
            return Option::Some(Expr { start: t.start, end: close.end, node: ExprNode::EmptyMap });
        }
        "(" => {
            advance(p);
            let inner: Expr = parse_expr_with_struct_lits(p)?;
            expect(p, ")")?;
            return Option::Some(inner);
        }
        "if" => {
            return parse_if_expr(p);
        }
        "match" => {
            return parse_match_expr(p);
        }
        _ => {
            fail(p, "expected expression, found " + describe(p, t), t);
            return Option::None;
        }
    }
}

fn parse_struct_lit(p: Parser, name: Token): Option[Expr] {
    expect(p, "{")?;
    let saved: bool = p.no_struct_lit;
    p.no_struct_lit = false;
    let inits: Option[[FieldInit]] = parse_field_inits(p);
    p.no_struct_lit = saved;
    let fields: [FieldInit] = inits?;
    let close: Token = expect(p, "}")?;
    return Option::Some(Expr { start: name.start, end: close.end, node: ExprNode::StructLit(ident_of(p, name), fields) });
}

// parse_struct_lit's field loop, split out so that `?` can leave it while the caller still restores the flag.
fn parse_field_inits(p: Parser): Option[[FieldInit]] {
    let fields: [FieldInit] = [];
    while !at(p, "}") {
        let field: Token = expect(p, "ident")?;
        expect(p, ":")?;
        let value: Expr = parse_expr(p)?;
        push(fields, FieldInit { name: ident_of(p, field), value: value });
        if !eat(p, ",") {
            break;
        }
    }
    return Option::Some(fields);
}

fn parse_variant_expr(p: Parser, enum_name: Token): Option[Expr] {
    expect(p, "::")?;
    let variant: Token = expect(p, "ident")?;
    var args: [Expr] = [];
    var end: int = variant.end;
    if eat(p, "(") {
        args = parse_expr_list(p, ")", false, false)?;
        let close: Token = expect(p, ")")?;
        end = close.end;
    }
    return Option::Some(Expr { start: enum_name.start, end: end, node: ExprNode::Variant(ident_of(p, enum_name), ident_of(p, variant), args) });
}

fn parse_if_expr(p: Parser): Option[Expr] {
    let kw: Token = expect(p, "if")?;
    let cond: Expr = parse_header_expr(p)?;
    let then: Expr = parse_expr_block(p)?;
    if !at(p, "else") {
        fail(p, "if expression requires an else branch", peek(p));
        return Option::None;
    }
    advance(p);
    let els: Expr = if at(p, "if") { parse_if_expr(p)? } else { parse_expr_block(p)? };
    return Option::Some(Expr { start: kw.start, end: previous(p).end, node: ExprNode::If(cond, then, els) });
}

fn parse_match_expr(p: Parser): Option[Expr] {
    let kw: Token = expect(p, "match")?;
    let scrutinee: Expr = parse_header_expr(p)?;
    expect(p, "{")?;
    let saved: bool = p.no_struct_lit;
    p.no_struct_lit = false;
    let parsed: Option[[Arm]] = parse_expr_arms(p);
    p.no_struct_lit = saved;
    let arms: [Arm] = parsed?;
    let close: Token = expect(p, "}")?;
    return Option::Some(Expr { start: kw.start, end: close.end, node: ExprNode::Match(ident_of(p, kw), scrutinee, arms) });
}

// parse_match_expr's arm loop, split out so that `?` can leave it while the caller still restores the flag.
fn parse_expr_arms(p: Parser): Option[[Arm]] {
    let arms: [Arm] = [];
    while true {
        let pattern: Pattern = parse_pattern(p)?;
        expect(p, "=>")?;
        if at(p, "{") {
            let b: Block = parse_block(p)?;
            push(arms, Arm { pattern: pattern, body: ArmBody::Block(b) });
            eat(p, ",");
            if at(p, "}") {
                break;
            }
            continue;
        }
        let body: Expr = parse_expr(p)?;
        push(arms, Arm { pattern: pattern, body: ArmBody::Expr(body) });
        if !eat(p, ",") || at(p, "}") {
            break;
        }
    }
    return Option::Some(arms);
}

fn parse_expr_block(p: Parser): Option[Expr] {
    expect(p, "{")?;
    let e: Expr = parse_expr_with_struct_lits(p)?;
    expect(p, "}")?;
    return Option::Some(e);
}

fn new_parser(lx: Lexer): Parser {
    return Parser { src: lx.src, tokens: lx.tokens, pos: 0, errors: [], no_struct_lit: false, base: 0 };
}

// A Parser whose spans (and errors) are offset by `base`: a file's place in a multi-file program. The lexer's own
// errors are not shifted; the caller does that.
fn new_parser_at(lx: Lexer, base: int): Parser {
    let tokens: [Token] = [];
    for t in lx.tokens {
        push(tokens, Token { kind: t.kind, start: t.start + base, end: t.end + base });
    }
    return Parser { src: lx.src, tokens: tokens, pos: 0, errors: [], no_struct_lit: false, base: base };
}
