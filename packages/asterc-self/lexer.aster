// expect-library
// The Aster lexer, imported by lex.aster and parser.aster, and through parser.aster by loader.aster, checker.aster and
// check.aster. `lex` turns source text into a Lexer holding every token and lexical error, with byte offsets;
// `lex_from` does the same from a given offset (the loader strips the BOM itself). It mirrors
// packages/asterc/src/lexer; tests/lex_aster.test.ts and tests/parse_aster.test.ts check it against the compiler's own
// lexer.

struct Token {
    kind: string,
    start: int,
    end: int,
}

struct LexError {
    start: int,
    end: int,
    message: string,
}

struct Lexer {
    src: string,
    pos: int,
    tokens: [Token],
    errors: [LexError],
}

fn min(a: int, b: int): int {
    if a < b {
        return a;
    }
    return b;
}

fn is_digit(c: int): bool {
    return c >= '0' && c <= '9';
}

fn is_ident_start(c: int): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_ident_part(c: int): bool {
    return is_ident_start(c) || is_digit(c);
}

fn is_escape(c: int): bool {
    return match c { 'n' | 't' | 'r' | '\\' | '"' | '\'' | '0' => true, _ => false };
}

fn is_space(c: int): bool {
    return match c { ' ' | '\t' | '\r' | '\n' => true, _ => false };
}

// Byte length of the UTF-8 sequence that starts with byte c.
fn utf8_len(c: int): int {
    if c >= 240 {
        return 4;
    }
    if c >= 224 {
        return 3;
    }
    if c >= 192 {
        return 2;
    }
    return 1;
}

fn is_keyword(w: string): bool {
    return match w {
        "fn" | "let" | "var" | "if" | "else" | "while" | "break" | "continue" | "return" | "true" | "false"
            | "struct" | "for" | "in" | "enum" | "match" | "import" => true,
        _ => false,
    };
}

fn is_punct(p: string): bool {
    return match p {
        "(" | ")" | "{" | "}" | "[" | "]" | "," | ":" | ";" | "." | ".." | "=" | "+" | "-" | "*" | "/" | "%" | "!"
            | "<" | "<=" | ">" | ">=" | "==" | "!=" | "&&" | "||" | "+=" | "-=" | "*=" | "/=" | "%=" | "::" | "=>"
            | "|" | "?" => true,
        _ => false,
    };
}

// The byte `offset` places past the current position, or -1 past the end.
fn peek_byte(lx: Lexer, offset: int): int {
    let i: int = lx.pos + offset;
    if i < len(lx.src) {
        return byte_at(lx.src, i);
    }
    return -1;
}

// Adds a token that runs from `start` to the current position.
fn push_token(lx: Lexer, kind: string, start: int) {
    push(lx.tokens, Token { kind: kind, start: start, end: lx.pos });
}

fn add_error(lx: Lexer, start: int, end: int, message: string) {
    push(lx.errors, LexError { start: start, end: end, message: message });
}

// Lexes a string literal starting at the opening quote. A literal ends at the closing quote, a newline or the end of
// the source; only the first counts as terminated.
fn lex_string(lx: Lexer) {
    let src: string = lx.src;
    let start: int = lx.pos;
    lx.pos += 1;
    var terminated: bool = false;
    while lx.pos < len(src) && byte_at(src, lx.pos) != '\n' {
        let c: int = byte_at(src, lx.pos);
        if c == '"' {
            lx.pos += 1;
            terminated = true;
            break;
        }
        if c != '\\' {
            lx.pos += 1;
            continue;
        }
        let next: int = peek_byte(lx, 1);
        if is_escape(next) {
            lx.pos += 2;
            continue;
        }
        var width: int = 1;
        if next != -1 && next != '\n' {
            width = 1 + utf8_len(next);
        }
        let end: int = min(lx.pos + width, len(src));
        add_error(lx, lx.pos, end, "invalid escape sequence '" + substring(src, lx.pos, end) + "'");
        lx.pos = end;
    }
    if !terminated {
        add_error(lx, start, lx.pos, "unterminated string literal");
    }
    push_token(lx, "string", start);
}

// Lexes a character literal starting at the opening quote. It scans to the closing quote on the same line, honouring
// backslash escapes, so an error spans the whole literal; then reports at most one error. Offsets are bytes, but the
// checks agree with the compiler's UTF-16 lexer: a body that is one non-ASCII character is several bytes here and one
// code unit there, and both call it not a single ASCII character.
fn lex_char(lx: Lexer) {
    let src: string = lx.src;
    let start: int = lx.pos;
    lx.pos += 1;
    var terminated: bool = false;
    while lx.pos < len(src) && byte_at(src, lx.pos) != '\n' {
        let c: int = byte_at(src, lx.pos);
        if c == '\\' && lx.pos + 1 < len(src) && byte_at(src, lx.pos + 1) != '\n' {
            lx.pos += 2;
            continue;
        }
        lx.pos += 1;
        if c == '\'' {
            terminated = true;
            break;
        }
    }
    var body_len: int = lx.pos - start - 1;
    if terminated {
        body_len -= 1;
    }
    let single: string = "character literal must be a single ASCII character";
    if !terminated {
        add_error(lx, start, lx.pos, "unterminated character literal");
    } else if body_len == 0 {
        add_error(lx, start, lx.pos, "empty character literal");
    } else if byte_at(src, start + 1) == '\\' {
        // A backslash and one more character: a valid escape, or an invalid one quoted whole. A character outside the
        // Basic Multilingual Plane (4 bytes) is two UTF-16 units, so the compiler sees a longer body.
        let next: int = byte_at(src, start + 2);
        let width: int = utf8_len(next);
        let valid: bool = body_len == 2 && is_escape(next);
        if !valid && width < 4 && body_len == 1 + width {
            add_error(lx, start + 1, start + 2 + width, "invalid escape sequence '" + substring(src, start + 1, start + 2 + width) + "'");
        } else if !valid {
            add_error(lx, start, lx.pos, single);
        }
    } else if body_len != 1 || byte_at(src, start + 1) < ' ' || byte_at(src, start + 1) > '~' {
        add_error(lx, start, lx.pos, single);
    }
    push_token(lx, "char", start);
}

// The length of a leading UTF-8 byte order mark, which the compiler skips; offsets still count its bytes.
fn bom_len(src: string): int {
    if len(src) >= 3 && byte_at(src, 0) == 239 && byte_at(src, 1) == 187 && byte_at(src, 2) == 191 {
        return 3;
    }
    return 0;
}

fn lex(src: string): Lexer {
    return lex_from(src, bom_len(src));
}

// Lexes `src` from byte `pos`. The loader strips the byte order mark itself, so it starts at 0: a second mark is then
// an unexpected character, as in the TypeScript lexer.
fn lex_from(src: string, pos: int): Lexer {
    let lx: Lexer = Lexer { src: src, pos: pos, tokens: [], errors: [] };
    while lx.pos < len(src) {
        let start: int = lx.pos;
        let c: int = byte_at(src, start);
        if is_space(c) {
            lx.pos += 1;
        } else if c == '/' && peek_byte(lx, 1) == '/' {
            while lx.pos < len(src) && byte_at(src, lx.pos) != '\n' {
                lx.pos += 1;
            }
        } else if is_digit(c) {
            while lx.pos < len(src) && is_digit(byte_at(src, lx.pos)) {
                lx.pos += 1;
            }
            push_token(lx, "int", start);
        } else if is_ident_start(c) {
            while lx.pos < len(src) && is_ident_part(byte_at(src, lx.pos)) {
                lx.pos += 1;
            }
            let word: string = substring(src, start, lx.pos);
            if word == "_" || is_keyword(word) {
                push_token(lx, word, start);
            } else {
                push_token(lx, "ident", start);
            }
        } else if c == '"' {
            lex_string(lx);
        } else if c == '\'' {
            lex_char(lx);
        } else if start + 2 <= len(src) && is_punct(substring(src, start, start + 2)) {
            lx.pos += 2;
            push_token(lx, substring(src, start, lx.pos), start);
        } else if is_punct(substring(src, start, start + 1)) {
            lx.pos += 1;
            push_token(lx, substring(src, start, lx.pos), start);
        } else {
            lx.pos = min(start + utf8_len(c), len(src));
            add_error(lx, start, lx.pos, "unexpected character '" + substring(src, start, lx.pos) + "'");
        }
    }
    push_token(lx, "eof", lx.pos);
    return lx;
}
