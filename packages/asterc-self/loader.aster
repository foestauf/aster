// expect-library
// The Aster program loader, written in Aster. `load_program` lexes and
// parses the root file and, depth first in the order the imports appear, every file it reaches, each once. Every file
// gets a global base (the root's is 0, each later file's is one past the end of the previous one), and every span the
// lexer and parser produce is offset by it, so spans are global and sort by load order, then position. Offsets are in
// bytes of the BOM-stripped text. tests/check_aster.test.ts checks the result, through check.aster, against the
// goldens in tests/golden/check/.

import "parser.aster";

// A loaded file. `src` has any byte order mark stripped; `bom` is the 3 bytes it took, or 0.
struct SourceFile {
    path: string,
    src: string,
    base: int,
    bom: int,
}

// A file-local source range (docs/inspect/README.md): byte offsets into the file as stored, BOM included, and 1-based
// lines and UTF-16 columns, the BOM not counted.
struct Range {
    start: int,
    end: int,
    start_line: int,
    start_col: int,
    end_line: int,
    end_col: int,
}

// A secondary location of a diagnostic: `role` says what it is (`import-target`: the file an import failed to load).
// `range` is None when there is no position in it.
struct Related {
    role: string,
    path: string,
    range: Option[Range],
}

// A diagnostic, with global byte offsets, its stable code (docs/inspect/README.md) and any related locations.
struct Diag {
    code: string,
    start: int,
    end: int,
    message: string,
    related: [Related],
}

// Every loaded file (root first, in load order), the items of all of them (in load order), the end offset of the
// root (declarations at or past it come from imports), and the lexical, syntax and import errors, unsorted.
struct Loaded {
    files: [SourceFile],
    items: [Item],
    root_end: int,
    diags: [Diag],
}

// ---- paths

// The directory part of a path, as Node's posix `path.dirname` computes it.
fn dirname(path: string): string {
    if len(path) == 0 {
        return ".";
    }
    let has_root: bool = byte_at(path, 0) == '/';
    var end: int = -1;
    var matched_slash: bool = true;
    var i: int = len(path) - 1;
    while i >= 1 {
        if byte_at(path, i) == '/' {
            if !matched_slash {
                end = i;
                break;
            }
        } else {
            matched_slash = false;
        }
        i -= 1;
    }
    if end == -1 {
        if has_root {
            return "/";
        }
        return ".";
    }
    if has_root && end == 1 {
        return "//";
    }
    return substring(path, 0, end);
}

// A file's identity: the path with repeated `/` collapsed, `.` segments dropped and `name/..` pairs resolved. The
// compiler uses the real path instead; the two differ through symlinks, and for a relative root whose imports climb out
// of the working directory and back in (the real path resolves against the working directory, this doesn't).
fn normalise(path: string): string {
    let absolute: bool = len(path) > 0 && byte_at(path, 0) == '/';
    let stack: [string] = [];
    var start: int = 0;
    for i in 0..len(path) + 1 {
        if i == len(path) || byte_at(path, i) == '/' {
            let seg: string = substring(path, start, i);
            start = i + 1;
            if seg == "" || seg == "." {
                continue;
            }
            if seg == ".." && len(stack) > 0 && stack[len(stack) - 1] != ".." {
                pop(stack);
            } else if seg == ".." && absolute && len(stack) == 0 {
                continue;
            } else {
                push(stack, seg);
            }
        }
    }
    var out: string = "";
    if absolute {
        out = "/";
    }
    for k in 0..len(stack) {
        if k > 0 {
            out += "/";
        }
        out += stack[k];
    }
    if out == "" {
        return ".";
    }
    return out;
}

// The value of a string literal's body (the source text between its quotes), or None if it holds a NUL byte, which no
// path can contain. Invalid escapes, already reported by the lexer, are kept as written.
fn decode_literal(body: string): Option[string] {
    var out: string = "";
    var i: int = 0;
    var run: int = 0;
    while i < len(body) {
        if byte_at(body, i) != '\\' || i + 1 >= len(body) {
            i += 1;
            continue;
        }
        out += substring(body, run, i);
        let c: int = byte_at(body, i + 1);
        if c == '0' {
            return Option::None;
        }
        out += match c {
            'n' => "\n",
            't' => "\t",
            'r' => "\r",
            '\\' => "\\",
            '"' => "\"",
            '\'' => "'",
            _ => substring(body, i, i + 2),
        };
        i += 2;
        run = i;
    }
    return Option::Some(out + substring(body, run, len(body)));
}

// ---- source encoding

// Offset of the first byte of the first ill-formed UTF-8 sequence in `raw` (Unicode Table 3-7), or -1 if it is
// well-formed. Unicode Table 3-7's well-formedness rules, applied byte by byte.
fn utf8_invalid_at(raw: string): int {
    var i: int = 0;
    while i < len(raw) {
        let b: int = byte_at(raw, i);
        if b < 128 {
            i += 1;
            continue;
        }
        // The sequence length and the range of its second byte; later bytes are always 80..BF.
        var n: int = 0;
        var lo: int = 128;
        var hi: int = 191;
        if b >= 194 && b <= 223 {
            n = 2;
        } else if b >= 224 && b <= 239 {
            n = 3;
            if b == 224 {
                lo = 160;
            }
            if b == 237 {
                hi = 159;
            }
        } else if b >= 240 && b <= 244 {
            n = 4;
            if b == 240 {
                lo = 144;
            }
            if b == 244 {
                hi = 143;
            }
        } else {
            return i;
        }
        if i + n > len(raw) {
            return i;
        }
        let second: int = byte_at(raw, i + 1);
        if second < lo || second > hi {
            return i;
        }
        for k in 2..n {
            let c: int = byte_at(raw, i + k);
            if c < 128 || c > 191 {
                return i;
            }
        }
        i += n;
    }
    return -1;
}

// `invalid UTF-8 at line <L>, byte <B>`: L is 1-based, B is the 0-based offset `at` into the file as stored.
fn utf8_reason(raw: string, at: int): string {
    var line: int = 1;
    for i in 0..at {
        if byte_at(raw, i) == '\n' {
            line += 1;
        }
    }
    return "invalid UTF-8 at line " + int_to_string(line) + ", byte " + int_to_string(at);
}

// A line and a UTF-16 column, both 1-based.
struct Pos {
    line: int,
    col: int,
}

// UTF-16 code units in src[from..to): one per UTF-8 lead byte, two for a 4-byte sequence's lead, none for a
// continuation byte.
fn utf16_units(src: string, from: int, to: int): int {
    var n: int = 0;
    for i in from..to {
        let b: int = byte_at(src, i);
        if b < 128 || b >= 192 {
            n += 1;
            if b >= 240 {
                n += 1;
            }
        }
    }
    return n;
}

// The line and column of offset `at` in `src` (BOM-stripped). Only `\n` ends a line.
fn file_pos(src: string, at: int): Pos {
    var line: int = 1;
    var line_start: int = 0;
    for i in 0..at {
        if byte_at(src, i) == '\n' {
            line += 1;
            line_start = i + 1;
        }
    }
    return Pos { line: line, col: 1 + utf16_units(src, line_start, at) };
}

// The range of src[start..end) (offsets into the BOM-stripped `src`; `bom` bytes were stripped), the end clamped to
// the file and the start to the end.
fn file_range(src: string, bom: int, start: int, end: int): Range {
    let e: int = min(end, len(src));
    let s: int = min(start, e);
    let a: Pos = file_pos(src, s);
    let b: Pos = file_pos(src, e);
    return Range { start: s + bom, end: e + bom, start_line: a.line, start_col: a.col, end_line: b.line, end_col: b.col };
}

// The one-byte range of the first ill-formed byte, at offset `at` of the raw (BOM-included) file `raw`: line and column
// count the well-formed bytes before it, and the byte itself is one column wide.
fn invalid_range(raw: string, at: int): Range {
    let bom: int = bom_len(raw);
    let p: Pos = file_pos(substring(raw, bom, len(raw)), at - bom);
    return Range { start: at, end: at + 1, start_line: p.line, start_col: p.col, end_line: p.line, end_col: p.col + 1 };
}

// ---- loading

// Lexes and parses one file at the next base, then loads its imports that are not in `seen` yet.
fn visit(ld: Loaded, seen: Set[string], path: string, raw: string) {
    let bom: int = bom_len(raw);
    let src: string = substring(raw, bom, len(raw));
    var base: int = 0;
    if len(ld.files) > 0 {
        let last: SourceFile = ld.files[len(ld.files) - 1];
        base = last.base + len(last.src) + 1;
    }
    push(ld.files, SourceFile { path: path, src: src, base: base, bom: bom });
    let lx: Lexer = lex_from(src, 0);
    for e in lx.errors {
        push(ld.diags, Diag { code: e.code, start: e.start + base, end: e.end + base, message: e.message, related: [] });
    }
    let p: Parser = new_parser_at(lx, base);
    let items: [Item] = parse_program(p);
    for e in p.errors {
        push(ld.diags, Diag { code: e.code, start: e.start, end: e.end, message: e.message, related: [] });
    }
    for item in items {
        push(ld.items, item);
    }
    for item in items {
        if let Item::Import(imp) = item {
            load_import(ld, seen, path, src, base, imp);
        }
    }
}

// Loads the file `imp` names, relative to the importing file `from` (whose text is `src`, at `base`), unless it is
// already loaded. A file that cannot be read is reported at the path literal.
fn load_import(ld: Loaded, seen: Set[string], from: string, src: string, base: int, imp: ImportDecl) {
    // The literal as written, escapes intact, for the message.
    let literal: string = substring(src, imp.path_start - base + 1, imp.path_end - base - 1);
    let Option::Some(decoded) = decode_literal(literal) else {
        import_error(ld, imp, literal, "import.invalid-path", "invalid path", []);
        return;
    };
    var target: string = decoded;
    if len(decoded) == 0 || byte_at(decoded, 0) != '/' {
        target = dirname(from) + "/" + decoded;
    }
    let id: string = normalise(target);
    if set_has(seen, id) {
        return;
    }
    match read_file(target) {
        Result::Ok(text) => {
            let bad: int = utf8_invalid_at(text);
            if bad != -1 {
                let related: [Related] = [Related { role: "import-target", path: target, range: Option::Some(invalid_range(text, bad)) }];
                import_error(ld, imp, literal, "import.invalid-utf8", utf8_reason(text, bad), related);
                return;
            }
            set_add(seen, id);
            visit(ld, seen, target, text);
        }
        Result::Err(msg) => {
            // read_file's error is `<path>: <reason>`; the compiler quotes only the reason.
            let prefix: string = target + ": ";
            var reason: string = msg;
            if len(msg) >= len(prefix) && substring(msg, 0, len(prefix)) == prefix {
                reason = substring(msg, len(prefix), len(msg));
            }
            let related: [Related] = [Related { role: "import-target", path: target, range: Option::None }];
            import_error(ld, imp, literal, "import.unreadable", reason, related);
        }
    }
}

// Reports an import that can't be loaded, at its path literal (`literal` as written).
fn import_error(ld: Loaded, imp: ImportDecl, literal: string, code: string, reason: string, related: [Related]) {
    push(ld.diags, Diag { code: code, start: imp.path_start, end: imp.path_end, message: "cannot import '" + literal + "': " + reason, related: related });
}

// Loads the program rooted at `path`, whose contents are `src`.
fn load_program(path: string, src: string): Loaded {
    let ld: Loaded = Loaded { files: [], items: [], root_end: 0, diags: [] };
    let seen: Set[string] = {};
    set_add(seen, normalise(path));
    visit(ld, seen, path, src);
    ld.root_end = ld.files[0].base + len(ld.files[0].src);
    return ld;
}
