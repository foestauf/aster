// expect-library
// The Aster type checker, written in Aster: covering generics, builtins and the type
// representation it needs. `check_program` checks the items of a loaded program and
// returns its diagnostics, with global byte offsets, and the typed program: its structs, enums and functions, with
// their locals and typed bodies. tests/check_aster.test.ts checks its diagnostics and summary, through check.aster,
// against the goldens in tests/golden/check/. The functions keep the original checker's order, in snake_case.
//
// Aster has no maps, so each of the checker's name tables is an array searched linearly by a `find_*` helper that
// returns the index of the entry, if any.
//
// The typed program has a field for each thing the checker records: `check_expr` returns an expression's typed node, and
// `check_stmt` and `check_block` a statement's or block's typed node with whether it diverges. That covers `?`,
// `let ... else`, `if let`, `match` and its patterns, and every local with a stable id. typed_dump.aster prints
// the tree in a canonical format, which the self-host fixed point and tests/selfhost_golden.test.ts exercise on the
// whole accepted corpus.

import "loader.aster";

// ---- types (types/type.ts)

// An Aster type. `Error` marks a type that could not be determined; rules involving it are suppressed. An
// instantiation of a generic enum is an `Enum` named by its full type string (`Option[int]`).
enum Type {
    Int,
    Bool,
    Str,
    Void,
    Never,
    Struct(string),
    Enum(string),
    Array(Type),
    Map(Type, Type),
    Set(Type),
    Error,
}

// The TS checker's `kind`: `int`, `bool`, `string`, `void`, `never`, `struct`, `enum`, `array`, `map`, `set` or
// `error`.
fn kind_of_type(t: Type): string {
    return match t {
        Type::Int => "int",
        Type::Bool => "bool",
        Type::Str => "string",
        Type::Void => "void",
        Type::Never => "never",
        Type::Struct(_) => "struct",
        Type::Enum(_) => "enum",
        Type::Array(_) => "array",
        Type::Map(_, _) => "map",
        Type::Set(_) => "set",
        Type::Error => "error",
    };
}

fn type_equals(a: Type, b: Type): bool {
    match a {
        Type::Struct(x) => {
            if let Type::Struct(y) = b {
                return x == y;
            }
        }
        Type::Enum(x) => {
            if let Type::Enum(y) = b {
                return x == y;
            }
        }
        Type::Array(x) => {
            if let Type::Array(y) = b {
                return type_equals(x, y);
            }
        }
        Type::Map(xk, xv) => {
            if let Type::Map(yk, yv) = b {
                return type_equals(xk, yk) && type_equals(xv, yv);
            }
        }
        Type::Set(x) => {
            if let Type::Set(y) = b {
                return type_equals(x, y);
            }
        }
        _ => {}
    }
    return kind_of_type(a) == kind_of_type(b);
}

// How a type is written in Aster source and named in diagnostics.
fn type_to_string(t: Type): string {
    return match t {
        Type::Struct(name) => name,
        Type::Enum(name) => name,
        Type::Array(elem) => "[" + type_to_string(elem) + "]",
        Type::Map(k, v) => "Map[" + type_to_string(k) + ", " + type_to_string(v) + "]",
        Type::Set(k) => "Set[" + type_to_string(k) + "]",
        _ => kind_of_type(t),
    };
}

// The type string of an instantiation; it is injective, so names alone identify instantiations.
fn instance_name(base: string, args: [Type]): string {
    var s: string = base + "[";
    for i in 0..len(args) {
        if i > 0 {
            s = s + ", ";
        }
        s = s + type_to_string(args[i]);
    }
    return s + "]";
}

// ---- builtins (check/builtins.ts)

// A function's parameter and return types, under its name.
struct Signature {
    name: string,
    params: [Type],
    ret: Type,
}

// Builtins the checker types by hand: `print`/`eprint` (int, bool or string), `len` (string or array), `push`/`pop`
// (any array).
fn special_builtins(): [string] {
    return ["print", "eprint", "len", "push", "pop"];
}

fn prelude_source(): string {
    return "enum Option[T] { Some(T), None }\nenum Result[T, E] { Ok(T), Err(E) }\n";
}

fn builtin_signatures(): [Signature] {
    return [
        Signature { name: "byte_at", params: [Type::Str, Type::Int], ret: Type::Int },
        Signature { name: "substring", params: [Type::Str, Type::Int, Type::Int], ret: Type::Str },
        Signature { name: "int_to_string", params: [Type::Int], ret: Type::Str },
        Signature { name: "panic", params: [Type::Str], ret: Type::Never },
        Signature { name: "exit", params: [Type::Int], ret: Type::Never },
        Signature { name: "read_stdin", params: [], ret: Type::Str },
        // The checker types read_file's call as Result[string, string].
        Signature { name: "read_file", params: [Type::Str], ret: Type::Void },
        // Likewise: write_file, remove_path and run_process return Result[int, string], make_temp_dir Result[string, string].
        Signature { name: "write_file", params: [Type::Str, Type::Str], ret: Type::Void },
        Signature { name: "make_temp_dir", params: [Type::Str], ret: Type::Void },
        Signature { name: "remove_path", params: [Type::Str], ret: Type::Void },
        Signature { name: "run_process", params: [Type::Array(Type::Str)], ret: Type::Void },
    ];
}

fn find_signature(sigs: [Signature], name: string): Option[int] {
    for i in 0..len(sigs) {
        if sigs[i].name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

fn is_builtin(name: string): bool {
    if let Option::Some(_) = find_signature(builtin_signatures(), name) {
        return true;
    }
    return contains(special_builtins(), name);
}

// ---- the typed program (check/types.ts)

// A parameter or local variable. `id` is unique within its function; params come first.
struct Local {
    id: int,
    name: string,
    ty: Type,
    mutable: bool,
}

struct TField {
    name: string,
    ty: Type,
}

// Fields in declaration order.
struct TStruct {
    name: string,
    fields: [TField],
}

// A variant's tag is its index in its enum.
struct TVariant {
    name: string,
    payload: [Type],
}

// Variants in declaration order. `payload_free` is true for a non-generic enum none of whose variants has a payload:
// only those enums can be compared with `==` and `!=`. An instantiation of a generic enum keeps its origin, which TS
// keeps on the type (`generic`): `base` is the generic enum's name and `args` its type arguments. For a non-generic
// enum, `base` is "" and `args` is empty.
struct TEnum {
    name: string,
    payload_free: bool,
    variants: [TVariant],
    base: string,
    args: [Type],
}

// `params` is the number of parameters: they are the first locals. `locals` holds every local, indexed by id. `body`
// is the typed body.
struct TFunction {
    name: string,
    params: int,
    locals: [Local],
    ret: Type,
    body: TBlock,
}

// ---- the typed tree (check/types.ts)

struct TBlock { stmts: [TStmt] }

// A match arm: an expression-bodied arm has an `Expr` body, a block-bodied one a `Block`.
struct TArm { pattern: TPattern, body: TArmBody }

enum TArmBody { Block(TBlock), Expr(TExpr) }

// A variant alternative of a pattern, with its tag.
struct TVariantRef { name: string, tag: int }

// `Variants` holds the alternatives and, when there is exactly one, one binder per payload slot (`None` for `_`);
// otherwise no binders. `Ints` holds decimal values and `Strings` decoded values.
enum TPattern { Wildcard, Variants([TVariantRef], [Option[Local]]), Ints([string]), Strings([string]) }

// An assignment target.
struct TPlace { ty: Type, node: TPlaceNode }

enum TPlaceNode { Local(Local), Field(TExpr, string), Index(TExpr, TExpr) }

struct TFieldInit { field: string, value: TExpr }

// `operand?`: continues with payload slot 0 of `ok_variant`, or returns `return_fail_variant` of `return_enum` (the
// enclosing function's return type) from the function. `fail_payload_type` is the operand's `Err` slot type for
// `Result`, carried into the returned `Err`, and `None` for `Option`.
struct TTry {
    operand: TExpr, ok_variant: string, ok_tag: int, fail_variant: string, fail_tag: int, return_type: Type,
    return_enum: string, return_fail_variant: string, return_fail_tag: int, fail_payload_type: Option[Type],
}

struct TExpr { ty: Type, node: TExprNode }

// `Int` holds the decimal value, `Str` the decoded value. `Call` names a user function, `Builtin` a builtin.
// `Variant` is (enum, variant, tag, args). `Error` stands for an expression that failed to check.
enum TExprNode {
    Int(string), Str(string), Bool(bool), Local(Local), Unary(string, TExpr), Binary(string, TExpr, TExpr),
    Call(string, [TExpr]), Builtin(string, [TExpr]), If(TExpr, TExpr, TExpr), Field(TExpr, string),
    Index(TExpr, TExpr), ArrayLit([TExpr]), StructLit(string, [TFieldInit]), Variant(string, string, int, [TExpr]),
    EnumCompare(string, TExpr, TExpr), Match(TExpr, [TArm]), Try(TTry), EmptyMap, Error,
}

enum TStmt {
    Let(Local, TExpr), Assign(TPlace, string, TExpr), If(TExpr, TBlock, Option[TBlock]), While(TExpr, TBlock),
    ForRange(Local, TExpr, TExpr, TBlock), ForEach(Local, TExpr, TBlock), Break, Continue, Return(Option[TExpr]),
    Match(TExpr, [TArm]), Block(TBlock), Expr(TExpr),
}

// A generic enum, kept as written until an instantiation names it (check/generics.ts).
struct Template {
    decl: EnumDecl,
    params: [string],
    broken: bool,
    has_errors: bool,
}

// ---- generic enums (check/generics.ts)

// True when the type parameter `param` occurs anywhere in `ref`.
fn mentions_param(ref: TypeExpr, param: string): bool {
    match ref.node {
        TypeNode::Array(elem) => {
            return mentions_param(elem, param);
        }
        TypeNode::Named(name, args) => {
            if name == param {
                return true;
            }
            for arg in args {
                if mentions_param(arg, param) {
                    return true;
                }
            }
            return false;
        }
    }
}

// An edge of find_expanding_enums' graph, between node indices into `ExpansionGraph.nodes`.
struct Edge {
    from: int,
    to: int,
    expanding: bool,
}

// The graph find_expanding_enums builds. Each node is an (enum, parameter) pair, kept as its key (`node_key`), in the
// order TS's `successors` Map first sees it; `successors` is parallel to `nodes`. The rest is Tarjan's state:
// `index` and `low` are -1 until a node is visited, and `component` -1 until it is assigned one.
struct ExpansionGraph {
    edges: [Edge],
    nodes: [string],
    successors: [[int]],
    index: [int],
    low: [int],
    stack: [int],
    on_stack: [bool],
    component: [int],
    visited: int,
    components: int,
}

// A node's key. Names never hold a space, so keys are unique, like TS's `${enumName}\0${param}`.
fn node_key(enum_name: string, param: string): string {
    return enum_name + " " + param;
}

fn find_node(g: ExpansionGraph, key: string): Option[int] {
    for i in 0..len(g.nodes) {
        if g.nodes[i] == key {
            return Option::Some(i);
        }
    }
    return Option::None;
}

// The index of the node `key`, adding it (with no successors) if it is new.
fn intern_node(g: ExpansionGraph, key: string): int {
    if let Option::Some(i) = find_node(g, key) {
        return i;
    }
    push(g.nodes, key);
    push(g.successors, []);
    push(g.index, -1);
    push(g.low, -1);
    push(g.on_stack, false);
    push(g.component, -1);
    return len(g.nodes) - 1;
}

fn add_edge(g: ExpansionGraph, from: string, to: string, expanding: bool) {
    let f: int = intern_node(g, from);
    let t: int = intern_node(g, to);
    push(g.successors[f], t);
    push(g.edges, Edge { from: f, to: t, expanding: expanding });
}

fn find_template_in(templates: [Template], name: string): Option[int] {
    for i in 0..len(templates) {
        if templates[i].decl.name.name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

// findExpandingEnums' `walk` for `template`: adds an edge for every argument of a template reference in `ref` that
// mentions one of `template`'s parameters.
fn walk_expansion(g: ExpansionGraph, templates: [Template], template: Template, ref: TypeExpr) {
    match ref.node {
        TypeNode::Array(elem) => {
            walk_expansion(g, templates, template, elem);
        }
        TypeNode::Named(name, args) => {
            // A type parameter that shadows a template's name is a parameter here, not a reference to the template.
            if !contains(template.params, name) {
                if let Option::Some(ti) = find_template_in(templates, name) {
                    let target: Template = templates[ti];
                    if len(target.params) == len(args) {
                        for i in 0..len(args) {
                            let arg: TypeExpr = args[i];
                            for param in template.params {
                                if !mentions_param(arg, param) {
                                    continue;
                                }
                                let exact: bool = match arg.node {
                                    TypeNode::Named(n, a) => len(a) == 0 && n == param,
                                    _ => false,
                                };
                                add_edge(g, node_key(template.decl.name.name, param), node_key(target.decl.name.name, target.params[i]), !exact);
                            }
                        }
                    }
                }
            }
            for arg in args {
                walk_expansion(g, templates, template, arg);
            }
        }
    }
}

// The generic enums that would need infinitely many instantiations (spec §3.3), in declaration order. Nodes are
// (enum, parameter) pairs; passing an argument that mentions parameter P of E to parameter Q of F adds the edge
// (E, P) -> (F, Q), which is expanding unless the argument is exactly P. An enum expands infinitely when one of its
// nodes lies on a cycle through an expanding edge, which is when its strongly connected component contains one.
fn find_expanding_enums(templates: [Template]): [string] {
    let g: ExpansionGraph = ExpansionGraph {
        edges: [],
        nodes: [],
        successors: [],
        index: [],
        low: [],
        stack: [],
        on_stack: [],
        component: [],
        visited: 0,
        components: 0,
    };
    for template in templates {
        for variant in template.decl.variants {
            for ref in variant.payload {
                walk_expansion(g, templates, template, ref);
            }
        }
    }

    strongly_connected_components(g);
    let expanding_components: [bool] = [];
    for i in 0..g.components {
        push(expanding_components, false);
    }
    for edge in g.edges {
        let c: int = g.component[edge.from];
        if edge.expanding && c >= 0 && c == g.component[edge.to] {
            expanding_components[c] = true;
        }
    }
    let expanding: [string] = [];
    for template in templates {
        var on_cycle: bool = false;
        for param in template.params {
            if let Option::Some(n) = find_node(g, node_key(template.decl.name.name, param)) {
                let c: int = g.component[n];
                if c >= 0 && expanding_components[c] {
                    on_cycle = true;
                }
            }
        }
        if on_cycle {
            push(expanding, template.decl.name.name);
        }
    }
    return expanding;
}

// Tarjan's algorithm: sets the component of every node in `g`.
fn strongly_connected_components(g: ExpansionGraph) {
    for node in 0..len(g.nodes) {
        if g.index[node] < 0 {
            scc_visit(g, node);
        }
    }
}

fn scc_visit(g: ExpansionGraph, node: int) {
    g.index[node] = g.visited;
    g.low[node] = g.visited;
    g.visited += 1;
    push(g.stack, node);
    g.on_stack[node] = true;
    for next in g.successors[node] {
        if g.index[next] < 0 {
            scc_visit(g, next);
            if g.low[next] < g.low[node] {
                g.low[node] = g.low[next];
            }
        } else if g.on_stack[next] {
            if g.index[next] < g.low[node] {
                g.low[node] = g.index[next];
            }
        }
    }
    if g.low[node] != g.index[node] {
        return;
    }
    var member: int = -1;
    while member != node {
        member = pop(g.stack);
        g.on_stack[member] = false;
        g.component[member] = g.components;
    }
    g.components += 1;
}

// ---- checker state

// State shared by the whole program check. `structs` holds every accepted struct; `enums` every accepted non-generic
// enum and then every instantiation, in order of first use (all non-generic enums are registered before any type is
// resolved, so the two never interleave); `templates` every generic enum, the prelude's first. Struct, enum and
// template names share the type namespace.
struct Env {
    diags: [Diag],
    structs: [TStruct],
    enums: [TEnum],
    templates: [Template],
}

// An enclosing loop, and whether a `break` leaves it.
struct Loop {
    has_break: bool,
}

// Per-function checking state. `scopes` is a stack of scopes, each holding its locals in declaration order, and
// `loops` the stack of loops around the statement being checked.
struct Ctx {
    env: Env,
    signatures: [Signature],
    ret: Type,
    locals: [Local],
    scopes: [[Local]],
    loops: [Loop],
}

// The checker's result: its diagnostics, unsorted, and the typed program.
struct Checked {
    diags: [Diag],
    structs: [TStruct],
    enums: [TEnum],
    functions: [TFunction],
}

fn primitive_type(name: string): Option[Type] {
    if name == "int" {
        return Option::Some(Type::Int);
    }
    if name == "bool" {
        return Option::Some(Type::Bool);
    }
    if name == "string" {
        return Option::Some(Type::Str);
    }
    if name == "void" {
        return Option::Some(Type::Void);
    }
    if name == "never" {
        return Option::Some(Type::Never);
    }
    return Option::None;
}

fn is_primitive(name: string): bool {
    return match primitive_type(name) {
        Option::Some(_) => true,
        Option::None => false,
    };
}

fn report(env: Env, message: string, start: int, end: int) {
    push(env.diags, Diag { start: start, end: end, message: message });
}

fn builtin_type_message(name: string): string {
    return "'" + name + "' is a builtin type and cannot be redefined";
}

// Names of predeclared types, which no declaration may reuse.
fn is_builtin_type(name: string): bool {
    return name == "Option" || name == "Result" || name == "Map" || name == "Set";
}

fn find_struct(env: Env, name: string): Option[int] {
    for i in 0..len(env.structs) {
        if env.structs[i].name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

fn find_enum(env: Env, name: string): Option[int] {
    for i in 0..len(env.enums) {
        if env.enums[i].name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

fn find_template(env: Env, name: string): Option[int] {
    return find_template_in(env.templates, name);
}

// "struct" / "enum" when `name` is already taken in the type namespace, else "". Templates count as enums.
fn type_kind_of(env: Env, name: string): string {
    if let Option::Some(_) = find_struct(env, name) {
        return "struct";
    }
    if let Option::Some(_) = find_enum(env, name) {
        return "enum";
    }
    if let Option::Some(_) = find_template(env, name) {
        return "enum";
    }
    return "";
}

fn is_error(t: Type): bool {
    return match t {
        Type::Error => true,
        _ => false,
    };
}

fn is_void(t: Type): bool {
    return match t {
        Type::Void => true,
        _ => false,
    };
}

fn is_never(t: Type): bool {
    return match t {
        Type::Never => true,
        _ => false,
    };
}

// A type parameter bound to a type. A `[Binding]` stands in for TS's `Map<string, Type>`: `find_binding` searches it
// from the end, so a later binding of the same name wins, as `Map.set` overwrites.
struct Binding {
    name: string,
    ty: Type,
}

fn find_binding(bindings: [Binding], name: string): Option[Type] {
    var i: int = len(bindings) - 1;
    while i >= 0 {
        if bindings[i].name == name {
            return Option::Some(bindings[i].ty);
        }
        i -= 1;
    }
    return Option::None;
}

// Resolves a written type with no type parameters in scope, reporting its errors and instantiating what it names:
// TS's `resolveType(env, ref)` with its defaults.
fn resolve_type(env: Env, ref: TypeExpr): Type {
    return resolve_type_with(env, ref, [], false, true, false);
}

// Resolves a written type. `bindings` maps the type parameters in scope to their types, and `quiet` suppresses
// diagnostics (used when instantiating, since the template's declaration was already checked). With `instantiates`
// off, a valid instantiation resolves to the error type instead of being created, so validating a template's
// payloads registers nothing. `allow_never` is set only for a function's declared return type, the one place `never`
// may be written.
fn resolve_type_with(env: Env, ref: TypeExpr, bindings: [Binding], quiet: bool, instantiates: bool, allow_never: bool): Type {
    match ref.node {
        TypeNode::Array(elem_ref) => {
            let elem: Type = resolve_type_with(env, elem_ref, bindings, quiet, instantiates, false);
            if is_void(elem) {
                say(env, quiet, "array element type cannot be void", elem_ref.start, elem_ref.end);
                return Type::Error;
            }
            if is_error(elem) {
                return Type::Error;
            }
            return Type::Array(elem);
        }
        TypeNode::Named(name, args) => {
            if let Option::Some(bound) = find_binding(bindings, name) {
                if len(args) > 0 {
                    say(env, quiet, "'" + name + "' is not generic", ref.start, ref.end);
                    return Type::Error;
                }
                return bound;
            }
            if name == "Map" || name == "Set" {
                return resolve_map_type(env, ref, name, args, bindings, quiet, instantiates);
            }
            if let Option::Some(ti) = find_template(env, name) {
                let template: Template = env.templates[ti];
                let expected: int = len(template.params);
                if len(args) != expected {
                    let noun: string = if expected == 1 { "argument" } else { "arguments" };
                    say(env, quiet, "'" + name + "' expects " + int_to_string(expected) + " type " + noun + ", got " + int_to_string(len(args)), ref.start, ref.end);
                    return Type::Error;
                }
                let types: [Type] = [];
                var any_error: bool = false;
                for arg in args {
                    var t: Type = resolve_type_with(env, arg, bindings, quiet, instantiates, false);
                    if is_void(t) {
                        say(env, quiet, "type argument cannot be void", arg.start, arg.end);
                        t = Type::Error;
                    }
                    if is_error(t) {
                        any_error = true;
                    }
                    push(types, t);
                }
                if any_error || template.broken || !instantiates {
                    return Type::Error;
                }
                return instantiate(env, template, types);
            }
            var found: Option[Type] = primitive_type(name);
            if name == "never" && !allow_never {
                say(env, quiet, "'never' is only allowed as a return type", ref.start, ref.end);
                return Type::Error;
            }
            if let Option::Some(_) = find_struct(env, name) {
                found = Option::Some(Type::Struct(name));
            }
            if let Option::Some(_) = find_enum(env, name) {
                found = Option::Some(Type::Enum(name));
            }
            let Option::Some(t) = found else {
                say(env, quiet, "unknown type '" + name + "'", ref.start, ref.end);
                return Type::Error;
            };
            if len(args) > 0 {
                say(env, quiet, "'" + name + "' is not generic", ref.start, ref.end);
                return Type::Error;
            }
            return t;
        }
    }
}

// `Map[K, V]` or `Set[K]`: the arity, then a key of int or string, then a value other than void.
fn resolve_map_type(env: Env, ref: TypeExpr, name: string, args: [TypeExpr], bindings: [Binding], quiet: bool, instantiates: bool): Type {
    let expected: int = if name == "Map" { 2 } else { 1 };
    if len(args) != expected {
        let noun: string = if expected == 1 { "argument" } else { "arguments" };
        say(env, quiet, "'" + name + "' expects " + int_to_string(expected) + " type " + noun + ", got " + int_to_string(len(args)), ref.start, ref.end);
        return Type::Error;
    }
    let key: Type = resolve_type_with(env, args[0], bindings, quiet, instantiates, false);
    var ok: bool = !is_error(key);
    let key_kind: string = kind_of_type(key);
    if ok && key_kind != "int" && key_kind != "string" {
        say(env, quiet, "map key must be int or string, found " + type_to_string(key), args[0].start, args[0].end);
        ok = false;
    }
    if name == "Set" {
        if !ok {
            return Type::Error;
        }
        return Type::Set(key);
    }
    let value: Type = resolve_type_with(env, args[1], bindings, quiet, instantiates, false);
    if is_void(value) {
        say(env, quiet, "map value cannot be void", args[1].start, args[1].end);
        return Type::Error;
    }
    if !ok || is_error(value) {
        return Type::Error;
    }
    return Type::Map(key, value);
}

// resolveType's `say`: reports unless `quiet`.
fn say(env: Env, quiet: bool, message: string, start: int, end: int) {
    if !quiet {
        report(env, message, start, end);
    }
}

// The type of `template` instantiated with `args`. The first use creates its TEnum, registering it before resolving
// the payloads so recursive enums terminate; the expansion check guarantees there are finitely many instantiations.
fn instantiate(env: Env, template: Template, args: [Type]): Type {
    let base: string = template.decl.name.name;
    let name: string = instance_name(base, args);
    if let Option::Some(_) = find_enum(env, name) {
        return Type::Enum(name);
    }
    let enum_type: TEnum = TEnum { name: name, payload_free: false, variants: [], base: base, args: args };
    push(env.enums, enum_type);
    let bindings: [Binding] = [];
    for i in 0..len(template.params) {
        push(bindings, Binding { name: template.params[i], ty: args[i] });
    }
    for variant in template.decl.variants {
        // Validating the template already reported the duplicate.
        if let Option::Some(_) = find_tvariant(enum_type.variants, variant.name.name) {
            continue;
        }
        let payload: [Type] = [];
        for ref in variant.payload {
            let t: Type = resolve_type_with(env, ref, bindings, true, true, false);
            push(payload, if is_void(t) { Type::Error } else { t });
        }
        push(enum_type.variants, TVariant { name: variant.name.name, payload: payload });
    }
    return Type::Enum(name);
}

fn find_tfield(fields: [TField], name: string): Option[int] {
    for i in 0..len(fields) {
        if fields[i].name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

fn find_tvariant(variants: [TVariant], name: string): Option[int] {
    for i in 0..len(variants) {
        if variants[i].name == name {
            return Option::Some(i);
        }
    }
    return Option::None;
}

// 'a struct' / 'an enum', for diagnostics.
fn article(kind: string): string {
    if kind == "struct" {
        return "a struct";
    }
    return "an enum";
}

// Registers every struct and enum name before resolving any field or payload type, so types can refer to each other
// in any order. Structs and enums share the type namespace; of two colliding declarations, the later one is reported.
// The items are in load order and spans are global, so they are already sorted by start, as collectTypes sorts them.
// A generic enum becomes a template: its parameters and the expansion check come before any payload is resolved, and
// its payloads are then resolved once, with every parameter bound to the error type, only to report its errors.
fn collect_types(env: Env, items: [Item]) {
    // The accepted structs and non-generic enums, parallel to env.structs and env.enums.
    let struct_decls: [StructDecl] = [];
    let enum_decls: [EnumDecl] = [];
    // The user's generic enums; env.templates also holds the prelude's.
    let templates: [Template] = [];
    for item in items {
        var name: Ident = Ident { name: "", start: 0, end: 0 };
        var kind: string = "";
        match item {
            Item::Struct(d) => {
                name = d.name;
                kind = "struct";
            }
            Item::Enum(d) => {
                name = d.name;
                kind = "enum";
            }
            _ => {}
        }
        if kind == "" {
            continue;
        }
        let previous: string = type_kind_of(env, name.name);
        if let Option::Some(_) = primitive_type(name.name) {
            report(env, "'" + name.name + "' is a built-in type and cannot be redefined", name.start, name.end);
        } else if is_builtin_type(name.name) {
            report(env, builtin_type_message(name.name), name.start, name.end);
        } else if is_builtin(name.name) {
            report(env, "'" + name.name + "' is a builtin function and cannot be redefined", name.start, name.end);
        } else if previous == kind {
            report(env, "duplicate " + kind + " '" + name.name + "'", name.start, name.end);
        } else if previous != "" {
            report(env, "'" + name.name + "' is already declared as " + article(previous), name.start, name.end);
        } else {
            match item {
                Item::Struct(d) => {
                    push(env.structs, TStruct { name: d.name.name, fields: [] });
                    push(struct_decls, d);
                }
                Item::Enum(d) => {
                    if len(d.params) > 0 {
                        let params: [string] = [];
                        for p in d.params {
                            push(params, p.name);
                        }
                        let template: Template = Template { decl: d, params: params, broken: false, has_errors: false };
                        push(env.templates, template);
                        push(templates, template);
                    } else {
                        var payload_free: bool = true;
                        for v in d.variants {
                            if len(v.payload) > 0 {
                                payload_free = false;
                            }
                        }
                        push(env.enums, TEnum { name: d.name.name, payload_free: payload_free, variants: [], base: "", args: [] });
                        push(enum_decls, d);
                    }
                }
                _ => {}
            }
        }
    }
    for template in templates {
        let decl: EnumDecl = template.decl;
        let before: int = len(env.diags);
        let seen: [string] = [];
        for param in decl.params {
            if contains(seen, param.name) {
                report(env, "duplicate type parameter '" + param.name + "'", param.start, param.end);
                continue;
            }
            push(seen, param.name);
            // A conflicting parameter stays bound, so the payloads that use it report nothing more.
            if is_primitive(param.name) || type_kind_of(env, param.name) != "" || is_builtin(param.name) {
                report(env, "type parameter '" + param.name + "' conflicts with a type of the same name", param.start, param.end);
            }
            var used: bool = false;
            for v in decl.variants {
                for ref in v.payload {
                    if mentions_param(ref, param.name) {
                        used = true;
                    }
                }
            }
            if !used {
                report(env, "type parameter '" + param.name + "' is never used", param.start, param.end);
            }
        }
        if len(env.diags) > before {
            template.has_errors = true;
        }
    }
    let expanding: [string] = find_expanding_enums(env.templates);
    for template in templates {
        if !contains(expanding, template.decl.name.name) {
            continue;
        }
        let name: Ident = template.decl.name;
        report(env, "generic enum '" + name.name + "' expands infinitely", name.start, name.end);
        template.broken = true;
        template.has_errors = true;
    }
    for i in 0..len(struct_decls) {
        let st: TStruct = env.structs[i];
        for field in struct_decls[i].fields {
            if let Option::Some(_) = find_tfield(st.fields, field.name.name) {
                report(env, "duplicate field '" + field.name.name + "'", field.name.start, field.name.end);
                continue;
            }
            var t: Type = resolve_type(env, field.ty);
            if is_void(t) {
                report(env, "field cannot have type void", field.ty.start, field.ty.end);
                t = Type::Error;
            }
            push(st.fields, TField { name: field.name.name, ty: t });
        }
    }
    for i in 0..len(enum_decls) {
        let en: TEnum = env.enums[i];
        let decl: EnumDecl = enum_decls[i];
        for variant in decl.variants {
            if let Option::Some(_) = find_tvariant(en.variants, variant.name.name) {
                report(env, "duplicate variant '" + variant.name.name + "' in '" + decl.name.name + "'", variant.name.start, variant.name.end);
                continue;
            }
            let payload: [Type] = [];
            for ref in variant.payload {
                let t: Type = resolve_type(env, ref);
                if is_void(t) {
                    report(env, "payload cannot have type void", ref.start, ref.end);
                    push(payload, Type::Error);
                } else {
                    push(payload, t);
                }
            }
            push(en.variants, TVariant { name: variant.name.name, payload: payload });
        }
    }
    for template in templates {
        let decl: EnumDecl = template.decl;
        let before: int = len(env.diags);
        let placeholders: [Binding] = [];
        for param in template.params {
            push(placeholders, Binding { name: param, ty: Type::Error });
        }
        let names: [string] = [];
        for variant in decl.variants {
            if contains(names, variant.name.name) {
                report(env, "duplicate variant '" + variant.name.name + "' in '" + decl.name.name + "'", variant.name.start, variant.name.end);
                continue;
            }
            push(names, variant.name.name);
            for ref in variant.payload {
                let t: Type = resolve_type_with(env, ref, placeholders, false, false, false);
                if is_void(t) {
                    report(env, "payload cannot have type void", ref.start, ref.end);
                }
            }
        }
        if len(env.diags) > before {
            template.has_errors = true;
        }
    }
}

// `fn main(): int`, or `fn main(args: [string]): int` with any parameter name.
fn is_main_signature(sig: Signature): bool {
    if kind_of_type(sig.ret) != "int" {
        return false;
    }
    if len(sig.params) == 0 {
        return true;
    }
    if len(sig.params) != 1 {
        return false;
    }
    return match sig.params[0] {
        Type::Array(elem) => kind_of_type(elem) == "string",
        _ => false,
    };
}

// Option and Result, parsed from the prelude, to be registered as templates before any user declaration.
fn prelude_templates(): [Template] {
    let p: Parser = new_parser(lex(prelude_source()));
    let templates: [Template] = [];
    for item in parse_program(p) {
        if let Item::Enum(d) = item {
            let params: [string] = [];
            for tp in d.params {
                push(params, tp.name);
            }
            push(templates, Template { decl: d, params: params, broken: false, has_errors: false });
        }
    }
    return templates;
}

// Collects a function's signature, unless its name is taken; returns whether it was accepted. `main` declared at or
// past `root_end` comes from an imported file and is ignored as if not declared, so the root's own main (or its
// absence) is judged alone.
fn collect_signature(env: Env, sigs: [Signature], decl: FnDecl, root_end: int): bool {
    let name: string = decl.name.name;
    if name == "main" && decl.name.start >= root_end {
        report(env, "'main' must be declared in the root file", decl.name.start, decl.name.end);
        return false;
    }
    if is_builtin_type(name) {
        report(env, builtin_type_message(name), decl.name.start, decl.name.end);
        return false;
    }
    if is_builtin(name) {
        report(env, "'" + name + "' is a builtin function and cannot be redefined", decl.name.start, decl.name.end);
        return false;
    }
    let type_kind: string = type_kind_of(env, name);
    if type_kind != "" {
        report(env, "'" + name + "' is already declared as " + article(type_kind), decl.name.start, decl.name.end);
        return false;
    }
    if let Option::Some(_) = find_signature(sigs, name) {
        report(env, "duplicate function '" + name + "'", decl.name.start, decl.name.end);
        return false;
    }
    let params: [Type] = [];
    for p in decl.params {
        let t: Type = resolve_type(env, p.ty);
        if is_void(t) {
            report(env, "parameter cannot have type void", p.ty.start, p.ty.end);
            push(params, Type::Error);
        } else {
            push(params, t);
        }
    }
    let ret: Type = match decl.ret {
        Option::Some(r) => resolve_type_with(env, r, [], false, true, true),
        Option::None => Type::Void,
    };
    push(sigs, Signature { name: name, params: params, ret: ret });
    return true;
}

// Checks a whole program. `root_end` is the end of the root file: declarations at or past it come from imports.
fn check_program(items: [Item], root_end: int): Checked {
    let env: Env = Env { diags: [], structs: [], enums: [], templates: prelude_templates() };
    collect_types(env, items);

    // Pass 1: collect signatures so functions can be called before their declaration. `declared` is parallel to
    // `sigs`.
    let sigs: [Signature] = [];
    let declared: [FnDecl] = [];
    for item in items {
        if let Item::Fn(decl) = item {
            if collect_signature(env, sigs, decl, root_end) {
                push(declared, decl);
            }
        }
    }

    if let Option::Some(i) = find_signature(sigs, "main") {
        if !is_main_signature(sigs[i]) {
            let name: Ident = declared[i].name;
            report(env, "'main' must have signature 'fn main(): int' or 'fn main(args: [string]): int'", name.start, name.end);
        }
    } else {
        report(env, "missing 'fn main(): int'", 0, 0);
    }

    // Pass 2: check bodies.
    let functions: [TFunction] = [];
    for i in 0..len(declared) {
        push(functions, check_function(env, sigs, declared[i], sigs[i]));
    }
    return Checked { diags: env.diags, structs: env.structs, enums: env.enums, functions: functions };
}

fn check_function(env: Env, sigs: [Signature], decl: FnDecl, sig: Signature): TFunction {
    let ctx: Ctx = Ctx { env: env, signatures: sigs, ret: sig.ret, locals: [], scopes: [[]], loops: [] };
    for i in 0..len(decl.params) {
        let p: Typed = decl.params[i];
        declare(ctx, p.name, sig.params[i], false);
    }
    let body: CheckedBlock = check_block(ctx, decl.body);
    if is_never(sig.ret) {
        if !body.diverges {
            report(ctx.env, "function '" + decl.name.name + "' returns 'never' but can reach its end", decl.name.start, decl.name.end);
        }
    } else if !body.diverges && !is_void(sig.ret) && !is_error(sig.ret) {
        report(ctx.env, "function '" + decl.name.name + "' is missing a return on some paths", decl.name.start, decl.name.end);
    }
    return TFunction { name: decl.name.name, params: len(decl.params), locals: ctx.locals, ret: sig.ret, body: body.node };
}

fn find_local(scope: [Local], name: string): Option[int] {
    var i: int = len(scope) - 1;
    while i >= 0 {
        if scope[i].name == name {
            return Option::Some(i);
        }
        i -= 1;
    }
    return Option::None;
}

fn declare(ctx: Ctx, name: Ident, ty: Type, mutable: bool): Local {
    let scope: [Local] = ctx.scopes[len(ctx.scopes) - 1];
    if let Option::Some(_) = find_local(scope, name.name) {
        report(ctx.env, "'" + name.name + "' is already declared in this scope", name.start, name.end);
    }
    let local: Local = Local { id: len(ctx.locals), name: name.name, ty: ty, mutable: mutable };
    push(ctx.locals, local);
    push(scope, local);
    return local;
}

fn lookup(ctx: Ctx, name: string): Option[Local] {
    var i: int = len(ctx.scopes) - 1;
    while i >= 0 {
        let scope: [Local] = ctx.scopes[i];
        if let Option::Some(j) = find_local(scope, name) {
            return Option::Some(scope[j]);
        }
        i -= 1;
    }
    return Option::None;
}

fn is_function_name(ctx: Ctx, name: string): bool {
    if let Option::Some(_) = find_signature(ctx.signatures, name) {
        return true;
    }
    return is_builtin(name);
}

// A `never` value fits any expected type.
fn expect_type(ctx: Ctx, expected: Type, actual: Type, start: int, end: int) {
    if is_error(expected) || is_error(actual) || is_never(actual) || type_equals(expected, actual) {
        return;
    }
    report(ctx.env, "type mismatch: expected " + type_to_string(expected) + ", found " + type_to_string(actual), start, end);
}

fn check_condition(ctx: Ctx, e: Expr): TExpr {
    let cond: TExpr = check_expr(ctx, e, Option::None);
    if kind_of_type(cond.ty) != "bool" && !is_error(cond.ty) {
        report(ctx.env, "condition must be bool, found " + type_to_string(cond.ty), e.start, e.end);
    }
    return cond;
}

// ---- statements. Each returns its typed node and whether control can never continue past it.

struct CheckedStmt {
    node: TStmt,
    diverges: bool,
}

struct CheckedBlock {
    node: TBlock,
    diverges: bool,
}

fn check_block(ctx: Ctx, b: Block): CheckedBlock {
    push(ctx.scopes, []);
    let stmts: [TStmt] = [];
    var diverges: bool = false;
    for s in b.stmts {
        let checked: CheckedStmt = check_stmt(ctx, s);
        push(stmts, checked.node);
        if checked.diverges {
            diverges = true;
        }
    }
    pop(ctx.scopes);
    return CheckedBlock { node: TBlock { stmts: stmts }, diverges: diverges };
}

fn check_stmt(ctx: Ctx, s: Stmt): CheckedStmt {
    match s.node {
        StmtNode::Let(mutable, name, ty, init) => {
            var t: Type = resolve_type(ctx.env, ty);
            if is_void(t) {
                report(ctx.env, "variable cannot have type void", ty.start, ty.end);
                t = Type::Error;
            }
            let value: TExpr = check_expr(ctx, init, Option::Some(t));
            expect_type(ctx, t, value.ty, init.start, init.end);
            let local: Local = declare(ctx, name, t, mutable);
            return CheckedStmt { node: TStmt::Let(local, value), diverges: is_never(value.ty) };
        }
        StmtNode::LetElse(pattern, init, else_keyword, other) => {
            return check_let_else(ctx, pattern, init, else_keyword, other);
        }
        StmtNode::IfLet(pattern, scrutinee, then, other) => {
            return check_if_let(ctx, pattern, scrutinee, then, other);
        }
        StmtNode::Assign(op, target, value) => {
            let place: Option[TPlace] = check_place(ctx, target);
            // A target that was already reported has no type to guide the value, and must not cascade into it.
            let expected: Type = match place {
                Option::Some(p) => p.ty,
                Option::None => Type::Error,
            };
            let v: TExpr = check_expr(ctx, value, Option::Some(expected));
            let Option::Some(p) = place else {
                return CheckedStmt { node: TStmt::Expr(v), diverges: false };
            };
            if op == "=" {
                expect_type(ctx, p.ty, v.ty, value.start, value.end);
            } else {
                check_compound(ctx, s, op, p.ty, v.ty);
            }
            return CheckedStmt { node: TStmt::Assign(p, op, v), diverges: false };
        }
        StmtNode::If(cond, then, other) => {
            return check_if(ctx, cond, then, other);
        }
        StmtNode::While(cond, body) => {
            let c: TExpr = check_condition(ctx, cond);
            let lp: Loop = Loop { has_break: false };
            push(ctx.loops, lp);
            let b: CheckedBlock = check_block(ctx, body);
            pop(ctx.loops);
            let literal_true: bool = match cond.node {
                ExprNode::Bool(v) => v,
                _ => false,
            };
            return CheckedStmt { node: TStmt::While(c, b.node), diverges: literal_true && !lp.has_break };
        }
        StmtNode::ForRange(name, start, end, body) => {
            let from: TExpr = check_range_bound(ctx, start);
            let to: TExpr = check_range_bound(ctx, end);
            let f: ForBody = check_for_body(ctx, name, Type::Int, body);
            // A for loop may run zero times, so it never ends a control path on its own.
            return CheckedStmt { node: TStmt::ForRange(f.local, from, to, f.body), diverges: false };
        }
        StmtNode::ForEach(name, iterable, body) => {
            let array: TExpr = check_expr(ctx, iterable, Option::None);
            var elem: Type = Type::Error;
            match array.ty {
                Type::Array(t) => {
                    elem = t;
                }
                _ => {
                    if !is_error(array.ty) {
                        report(ctx.env, "cannot iterate over a value of type " + type_to_string(array.ty), iterable.start, iterable.end);
                    }
                }
            }
            let f: ForBody = check_for_body(ctx, name, elem, body);
            return CheckedStmt { node: TStmt::ForEach(f.local, array, f.body), diverges: false };
        }
        StmtNode::Break => {
            check_loop_exit(ctx, s, "break");
            return CheckedStmt { node: TStmt::Break, diverges: true };
        }
        StmtNode::Continue => {
            check_loop_exit(ctx, s, "continue");
            return CheckedStmt { node: TStmt::Continue, diverges: true };
        }
        StmtNode::Return(value) => {
            if is_never(ctx.ret) {
                report(ctx.env, "cannot return from a function that returns 'never'", s.start, s.end);
                var checked: Option[TExpr] = Option::None;
                if let Option::Some(v) = value {
                    checked = Option::Some(check_expr(ctx, v, Option::None));
                }
                return CheckedStmt { node: TStmt::Return(checked), diverges: true };
            }
            let Option::Some(v) = value else {
                if !is_void(ctx.ret) && !is_error(ctx.ret) {
                    report(ctx.env, "missing return value: expected " + type_to_string(ctx.ret), s.start, s.end);
                }
                return CheckedStmt { node: TStmt::Return(Option::None), diverges: true };
            };
            // In a void function the value is wrong whatever it is, so `[]` must not also be reported as uninferable.
            let expected: Type = if is_void(ctx.ret) { Type::Error } else { ctx.ret };
            let checked: TExpr = check_expr(ctx, v, Option::Some(expected));
            if is_void(ctx.ret) {
                report(ctx.env, "void function cannot return a value", v.start, v.end);
            } else {
                expect_type(ctx, ctx.ret, checked.ty, v.start, v.end);
            }
            return CheckedStmt { node: TStmt::Return(Option::Some(checked)), diverges: true };
        }
        StmtNode::Match(keyword, scrutinee, arms) => {
            return check_match(ctx, keyword, scrutinee, arms);
        }
        StmtNode::Block(b) => {
            let checked: CheckedBlock = check_block(ctx, b);
            return CheckedStmt { node: TStmt::Block(checked.node), diverges: checked.diverges };
        }
        StmtNode::Expr(e) => {
            let checked: TExpr = check_expr(ctx, e, Option::None);
            return CheckedStmt { node: TStmt::Expr(checked), diverges: is_never(checked.ty) };
        }
    }
}

// `break` or `continue` (`kind`): reported outside a loop; a `break` marks its loop as left.
fn check_loop_exit(ctx: Ctx, s: Stmt, kind: string) {
    if len(ctx.loops) == 0 {
        report(ctx.env, "'" + kind + "' outside of loop", s.start, s.end);
    } else if kind == "break" {
        ctx.loops[len(ctx.loops) - 1].has_break = true;
    }
}

fn check_if(ctx: Ctx, cond: Expr, then: Block, other: Else): CheckedStmt {
    let c: TExpr = check_condition(ctx, cond);
    let t: CheckedBlock = check_block(ctx, then);
    if let Else::None = other {
        return CheckedStmt { node: TStmt::If(c, t.node, Option::None), diverges: false };
    }
    let o: CheckedBlock = check_else(ctx, other);
    return CheckedStmt { node: TStmt::If(c, t.node, Option::Some(o.node)), diverges: t.diverges && o.diverges };
}

// Checks the else branch of an `if` or `if let`: a block, or a chained `if`/`if let` wrapped in a block. Callers
// handle an absent branch themselves.
fn check_else(ctx: Ctx, other: Else): CheckedBlock {
    match other {
        Else::None => {
            panic("internal: check_else without an else branch");
        }
        Else::Block(b) => {
            return check_block(ctx, b);
        }
        Else::If(nested) => {
            let StmtNode::If(c, t, e) = nested.node else {
                panic("internal: else-if is not an if");
            };
            let checked: CheckedStmt = check_if(ctx, c, t, e);
            return CheckedBlock { node: TBlock { stmts: [checked.node] }, diverges: checked.diverges };
        }
        Else::IfLet(nested) => {
            let StmtNode::IfLet(p, sc, t, e) = nested.node else {
                panic("internal: else-if-let is not an if let");
            };
            let checked: CheckedStmt = check_if_let(ctx, p, sc, t, e);
            return CheckedBlock { node: TBlock { stmts: [checked.node] }, diverges: checked.diverges };
        }
    }
}

// Puts an already-allocated local into the current scope, reporting a clash like `declare` does.
fn declare_existing(ctx: Ctx, name: Ident, local: Local) {
    let scope: [Local] = ctx.scopes[len(ctx.scopes) - 1];
    if let Option::Some(_) = find_local(scope, name.name) {
        report(ctx.env, "'" + name.name + "' is already declared in this scope", name.start, name.end);
    }
    push(scope, local);
}

// The arms let-else and if-let check as a match: the pattern with `body`, then a synthetic wildcard at the pattern's
// span. check_arms checks the wildcard arm's body from its `refutable` else branch, so it is left empty here.
fn refutable_arms(pattern: Pattern, body: Block): [Arm] {
    let wildcard: Pattern = Pattern { start: pattern.start, end: pattern.end, node: PatternNode::Wildcard };
    let empty: Block = Block { start: pattern.start, end: pattern.end, stmts: [] };
    return [Arm { pattern: pattern, body: ArmBody::Block(body) }, Arm { pattern: wildcard, body: ArmBody::Block(empty) }];
}

// `let P = init else { ... };`: the scrutinee, then the pattern's binders (allocated in the first arm's scope, which
// fixes their local ids), then the else block, which can't see them. The binders then enter the enclosing scope with
// the same locals. It becomes a match whose first arm is empty and whose wildcard arm is the else block, and falls
// through whenever the pattern matches.
fn check_let_else(ctx: Ctx, pattern: Pattern, init: Expr, else_keyword: Ident, other: Block): CheckedStmt {
    let keyword: Ident = Ident { name: "let", start: pattern.start, end: pattern.end };
    let m: MatchArms = check_arms(ctx, keyword, init, refutable_arms(pattern, Block { start: pattern.start, end: pattern.end, stmts: [] }), false, Option::None, Option::Some(Else::Block(other)));
    if !m.diverges[1] {
        report(ctx.env, "'else' block of 'let' must diverge", else_keyword.start, else_keyword.end);
    }
    // `m.binders` holds the binders' locals but not their spans, which a clash in the enclosing scope is reported at,
    // so walk the pattern again for each binder's name. `declared` skips a name the pattern repeats (already reported
    // as a duplicate binding), and only a variant pattern binds names.
    if let PatternNode::Variant(_, _, binders) = pattern.node {
        let declared: [string] = [];
        for b in binders {
            let Binder::Named(id) = b else {
                continue;
            };
            if contains(declared, id.name) {
                continue;
            }
            if let Option::Some(j) = find_local(m.binders, id.name) {
                push(declared, id.name);
                declare_existing(ctx, id, m.binders[j]);
            }
        }
    }
    let arms: [TArm] = [
        TArm { pattern: m.patterns[0], body: TArmBody::Block(TBlock { stmts: [] }) },
        TArm { pattern: m.patterns[1], body: m.bodies[1] },
    ];
    return CheckedStmt { node: TStmt::Match(m.scrutinee, arms), diverges: false };
}

// Whether an `if` or `if let` has an else branch (TS's `else !== null`).
fn has_else_branch(other: Else): bool {
    return match other {
        Else::None => false,
        _ => true,
    };
}

// `if let P = scrutinee { ... } else ...`: the scrutinee, then the pattern's binders (scoped to the then block), then
// the then block, then the else branch (check_else). It becomes a match of the pattern with the then block and a
// wildcard with the else branch (an empty block when there is none), and diverges when it has an else branch and both
// branches diverge.
fn check_if_let(ctx: Ctx, pattern: Pattern, scrutinee: Expr, then: Block, other: Else): CheckedStmt {
    let keyword: Ident = Ident { name: "if", start: pattern.start, end: pattern.end };
    let m: MatchArms = check_arms(ctx, keyword, scrutinee, refutable_arms(pattern, then), false, Option::None, Option::Some(other));
    let arms: [TArm] = [TArm { pattern: m.patterns[0], body: m.bodies[0] }, TArm { pattern: m.patterns[1], body: m.bodies[1] }];
    return CheckedStmt { node: TStmt::Match(m.scrutinee, arms), diverges: has_else_branch(other) && m.diverges[0] && m.diverges[1] };
}

fn check_range_bound(ctx: Ctx, e: Expr): TExpr {
    let bound: TExpr = check_expr(ctx, e, Option::None);
    if !is_error(bound.ty) && kind_of_type(bound.ty) != "int" {
        report(ctx.env, "range bound must be int, found " + type_to_string(bound.ty), e.start, e.end);
    }
    return bound;
}

// A for loop's variable and typed body.
struct ForBody {
    local: Local,
    body: TBlock,
}

// Checks a for-loop body with the immutable loop variable declared in a scope of its own.
fn check_for_body(ctx: Ctx, name: Ident, ty: Type, b: Block): ForBody {
    push(ctx.scopes, []);
    let local: Local = declare(ctx, name, ty, false);
    push(ctx.loops, Loop { has_break: false });
    let body: CheckedBlock = check_block(ctx, b);
    pop(ctx.loops);
    pop(ctx.scopes);
    return ForBody { local: local, body: body.node };
}

// ---- expressions

// The node for an expression that failed to check (TS's errorExpr).
fn error_expr(): TExpr {
    return TExpr { ty: Type::Error, node: TExprNode::Error };
}

// `expected` only guides array literals (and passes into if-expression branches); callers still check the result.
fn check_expr(ctx: Ctx, e: Expr, expected: Option[Type]): TExpr {
    match e.node {
        ExprNode::Int(value) => {
            return TExpr { ty: Type::Int, node: TExprNode::Int(value) };
        }
        ExprNode::Char(text) => {
            return TExpr { ty: Type::Int, node: TExprNode::Int(int_to_string(char_pattern_value(text))) };
        }
        ExprNode::Str(text) => {
            return TExpr { ty: Type::Str, node: TExprNode::Str(string_literal_value(text)) };
        }
        ExprNode::Bool(value) => {
            return TExpr { ty: Type::Bool, node: TExprNode::Bool(value) };
        }
        ExprNode::Name(name) => {
            if let Option::Some(local) = lookup(ctx, name) {
                return TExpr { ty: local.ty, node: TExprNode::Local(local) };
            }
            let message: string = if is_function_name(ctx, name) { "'" + name + "' is a function, not a value" } else { "undefined name '" + name + "'" };
            report(ctx.env, message, e.start, e.end);
            return error_expr();
        }
        ExprNode::Unary(op, operand_expr) => {
            let operand: TExpr = check_expr(ctx, operand_expr, Option::None);
            if is_error(operand.ty) {
                return error_expr();
            }
            let want: Type = if op == "-" { Type::Int } else { Type::Bool };
            if !type_equals(operand.ty, want) {
                report(ctx.env, "operator '" + op + "' cannot be applied to " + type_to_string(operand.ty), e.start, e.end);
                return error_expr();
            }
            return TExpr { ty: want, node: TExprNode::Unary(op, operand) };
        }
        ExprNode::Binary(op, left, right) => {
            return check_binary(ctx, e, op, left, right);
        }
        ExprNode::Call(callee, args) => {
            return check_call(ctx, e, callee, args);
        }
        ExprNode::Match(keyword, scrutinee, arms) => {
            return check_match_expr(ctx, e, keyword, scrutinee, arms, expected);
        }
        ExprNode::If(cond_expr, then_expr, other_expr) => {
            let cond: TExpr = check_condition(ctx, cond_expr);
            let then: TExpr = check_expr(ctx, then_expr, expected);
            let other: TExpr = check_expr(ctx, other_expr, expected);
            if is_error(then.ty) || is_error(other.ty) {
                return error_expr();
            }
            // A branch of type never doesn't take part in the "same type" rule.
            let ty: Type = if is_never(then.ty) { other.ty } else { then.ty };
            if !is_never(then.ty) && !is_never(other.ty) && !type_equals(then.ty, other.ty) {
                report(ctx.env, "if branches have different types: " + type_to_string(then.ty) + " and " + type_to_string(other.ty), e.start, e.end);
                return error_expr();
            }
            if is_void(ty) {
                report(ctx.env, "if expression cannot have type void", e.start, e.end);
                return error_expr();
            }
            return TExpr { ty: ty, node: TExprNode::If(cond, then, other) };
        }
        ExprNode::Field(object_expr, field) => {
            let object: TExpr = check_expr(ctx, object_expr, Option::None);
            if is_error(object.ty) {
                return error_expr();
            }
            if let Type::Struct(name) = object.ty {
                if let Option::Some(f) = find_field(ctx.env, name, field.name) {
                    return TExpr { ty: f.ty, node: TExprNode::Field(object, field.name) };
                }
            }
            report(ctx.env, "unknown field '" + field.name + "' on '" + type_to_string(object.ty) + "'", field.start, field.end);
            return error_expr();
        }
        ExprNode::StructLit(name, fields) => {
            return check_struct_lit(ctx, name, fields);
        }
        ExprNode::Try(operand) => {
            return check_try(ctx, e, operand);
        }
        ExprNode::Index(array_expr, index_expr) => {
            let array: TExpr = check_expr(ctx, array_expr, Option::None);
            let index: TExpr = check_expr(ctx, index_expr, Option::None);
            if !is_error(index.ty) && kind_of_type(index.ty) != "int" {
                report(ctx.env, "array index must be int, found " + type_to_string(index.ty), index_expr.start, index_expr.end);
            }
            if is_error(array.ty) {
                return error_expr();
            }
            let Type::Array(elem) = array.ty else {
                report(ctx.env, "cannot index a value of type " + type_to_string(array.ty), array_expr.start, array_expr.end);
                return error_expr();
            };
            if kind_of_type(index.ty) != "int" {
                return error_expr();
            }
            return TExpr { ty: elem, node: TExprNode::Index(array, index) };
        }
        ExprNode::ArrayLit(elements) => {
            return check_array_lit(ctx, e, elements, expected);
        }
        ExprNode::EmptyMap => {
            return check_empty_map(ctx, e, expected);
        }
        ExprNode::Variant(enum_name, variant, args) => {
            return check_variant_expr(ctx, e, enum_name, variant, args, expected);
        }
    }
}

// The index in `env.enums` of `t`'s instantiation when `t` is an `Option` or `Result`, else None: TS's `tryable`, whose
// name, base and arguments the TEnum holds.
fn tryable(env: Env, t: Type): Option[int] {
    let Type::Enum(name) = t else {
        return Option::None;
    };
    let ei: int = find_enum(env, name)?;
    let base: string = env.enums[ei].base;
    if base == "Option" || base == "Result" {
        return Option::Some(ei);
    }
    return Option::None;
}

// `e?` (§3.7): unwraps `Some`/`Ok`, or returns `None`/`Err(e)` from the enclosing function.
fn check_try(ctx: Ctx, e: Expr, operand_expr: Expr): TExpr {
    let operand: TExpr = check_expr(ctx, operand_expr, Option::None);
    let t: Type = operand.ty;
    if is_error(t) {
        return error_expr();
    }
    let Option::Some(oi) = tryable(ctx.env, t) else {
        report(ctx.env, "'?' applies to Option or Result, not '" + type_to_string(t) + "'", e.start, e.end);
        return error_expr();
    };
    let op: TEnum = ctx.env.enums[oi];
    let is_result: bool = op.base == "Result";
    let ty: Type = op.variants[0].payload[0];
    let fail_payload_type: Option[Type] = if is_result { Option::Some(op.variants[1].payload[0]) } else { Option::None };
    let return_enum: string = match ctx.ret {
        Type::Enum(name) => name,
        _ => "",
    };
    // Reachable when the return type failed to resolve (`fn f(): Option[Nope]`); only lowering is unreachable then.
    if is_error(ctx.ret) {
        let unresolved: TTry = TTry {
            operand: operand, ok_variant: op.variants[0].name, ok_tag: 0, fail_variant: op.variants[1].name, fail_tag: 1,
            return_type: ctx.ret, return_enum: return_enum, return_fail_variant: op.variants[1].name, return_fail_tag: 1,
            fail_payload_type: fail_payload_type,
        };
        return TExpr { ty: ty, node: TExprNode::Try(unresolved) };
    }
    // A return type that isn't tryable at all and one of the other kind get the same message.
    let kind: string = if is_result { "a Result" } else { "an Option" };
    let wrong_return: string = "'?' needs the function to return " + kind + ", but it returns '" + type_to_string(ctx.ret) + "'";
    let Option::Some(ri) = tryable(ctx.env, ctx.ret) else {
        report(ctx.env, wrong_return, e.start, e.end);
        return error_expr();
    };
    let ret: TEnum = ctx.env.enums[ri];
    if ret.base != op.base {
        report(ctx.env, wrong_return, e.start, e.end);
        return error_expr();
    }
    if is_result && !type_equals(op.args[1], ret.args[1]) {
        let mine: string = type_to_string(op.args[1]);
        let theirs: string = type_to_string(ret.args[1]);
        report(ctx.env, "'?' error type '" + mine + "' does not match the function's error type '" + theirs + "'", e.start, e.end);
        return error_expr();
    }
    let node: TTry = TTry {
        operand: operand, ok_variant: op.variants[0].name, ok_tag: 0, fail_variant: op.variants[1].name, fail_tag: 1,
        return_type: ctx.ret, return_enum: return_enum, return_fail_variant: ret.variants[1].name, return_fail_tag: 1,
        fail_payload_type: fail_payload_type,
    };
    return TExpr { ty: ty, node: TExprNode::Try(node) };
}

fn variant_arity_message(enum_name: string, variant: string, expected: int, found: int): string {
    let noun: string = if expected == 1 { "value" } else { "values" };
    return "variant '" + enum_name + "::" + variant + "' expects " + int_to_string(expected) + " " + noun + ", got " + int_to_string(found);
}

// A resolved `E::V`: a variant of a non-generic enum, or a variant of a generic enum's template. `Missing` when
// resolve_variant reported it (TS's null).
enum FoundVariant {
    Missing,
    Plain(TEnum, TVariant),
    Generic(Template, VariantDecl),
}

// Resolves `E::V`, reporting an unknown enum, a non-enum type or an unknown variant.
fn resolve_variant(env: Env, enum_name: Ident, variant_name: Ident): FoundVariant {
    if let Option::Some(ti) = find_template(env, enum_name.name) {
        let template: Template = env.templates[ti];
        for v in template.decl.variants {
            if v.name.name == variant_name.name {
                return FoundVariant::Generic(template, v);
            }
        }
        report(env, "unknown variant '" + variant_name.name + "' on '" + enum_name.name + "'", variant_name.start, variant_name.end);
        return FoundVariant::Missing;
    }
    let Option::Some(ei) = find_enum(env, enum_name.name) else {
        // Not an enum or a template, so type_kind_of finds a struct or nothing.
        let is_type: bool = type_kind_of(env, enum_name.name) == "struct" || is_primitive(enum_name.name);
        let message: string = if is_type { "'" + enum_name.name + "' is not an enum" } else { "unknown enum '" + enum_name.name + "'" };
        report(env, message, enum_name.start, enum_name.end);
        return FoundVariant::Missing;
    };
    let enum_type: TEnum = env.enums[ei];
    let Option::Some(vi) = find_tvariant(enum_type.variants, variant_name.name) else {
        report(env, "unknown variant '" + variant_name.name + "' on '" + enum_name.name + "'", variant_name.start, variant_name.end);
        return FoundVariant::Missing;
    };
    return FoundVariant::Plain(enum_type, enum_type.variants[vi]);
}

// `E::V(...)`, generic or not.
fn check_variant_expr(ctx: Ctx, e: Expr, enum_name: Ident, variant_name: Ident, args: [Expr], expected: Option[Type]): TExpr {
    match resolve_variant(ctx.env, enum_name, variant_name) {
        FoundVariant::Missing => {
            // Still check the values for their own errors; the `error` type keeps `[]` from being reported as
            // uninferable.
            for a in args {
                check_expr(ctx, a, Option::Some(Type::Error));
            }
            return error_expr();
        }
        FoundVariant::Generic(template, variant_decl) => {
            return check_generic_variant_expr(ctx, e, args, template, variant_decl, expected);
        }
        FoundVariant::Plain(enum_type, variant) => {
            let values: [TExpr] = [];
            for i in 0..len(args) {
                let slot: Type = if i < len(variant.payload) { variant.payload[i] } else { Type::Error };
                push(values, check_expr(ctx, args[i], Option::Some(slot)));
            }
            if len(values) != len(variant.payload) {
                report(ctx.env, variant_arity_message(enum_type.name, variant.name, len(variant.payload), len(values)), e.start, e.end);
                return error_expr();
            }
            for i in 0..len(values) {
                expect_type(ctx, variant.payload[i], values[i].ty, args[i].start, args[i].end);
            }
            let Option::Some(tag) = find_tvariant(enum_type.variants, variant.name) else {
                panic("internal: enum '" + enum_type.name + "' has no variant '" + variant.name + "'");
            };
            return TExpr { ty: Type::Enum(enum_type.name), node: TExprNode::Variant(enum_type.name, variant.name, tag, values) };
        }
    }
}

// Checks `E::V(...)` for a generic `E`, inferring its type arguments (spec §3.5): first from an expected
// instantiation of `E`, then from the values left to right. Each value takes its slot type as context once every
// parameter the slot mentions is known, and its type then fixes the parameters still unknown.
fn check_generic_variant_expr(ctx: Ctx, e: Expr, args: [Expr], template: Template, variant_decl: VariantDecl, expected: Option[Type]): TExpr {
    let base: string = template.decl.name.name;
    if template.broken || template.has_errors {
        // The declaration was already reported.
        for a in args {
            check_expr(ctx, a, Option::Some(Type::Error));
        }
        return error_expr();
    }
    let bindings: [Binding] = [];
    var expected_error: bool = false;
    if let Option::Some(t) = expected {
        expected_error = is_error(t);
        if let Type::Enum(name) = t {
            if let Option::Some(ei) = find_enum(ctx.env, name) {
                let en: TEnum = ctx.env.enums[ei];
                if en.base == base {
                    for i in 0..len(en.args) {
                        push(bindings, Binding { name: template.params[i], ty: en.args[i] });
                    }
                }
            }
        }
    }
    let slots: [TypeExpr] = variant_decl.payload;
    let values: [TExpr] = [];
    for i in 0..len(args) {
        if i >= len(slots) {
            push(values, check_expr(ctx, args[i], Option::Some(Type::Error)));
            continue;
        }
        let slot: TypeExpr = slots[i];
        var known: bool = true;
        for p in template.params {
            if let Option::Some(_) = find_binding(bindings, p) {
                continue;
            }
            if mentions_param(slot, p) {
                known = false;
            }
        }
        let context: Option[Type] = if known { Option::Some(resolve_type_with(ctx.env, slot, bindings, true, true, false)) } else { Option::None };
        let value: TExpr = check_expr(ctx, args[i], context);
        unify(ctx.env, template.params, slot, value.ty, bindings);
        push(values, value);
    }
    if len(values) != len(slots) {
        report(ctx.env, variant_arity_message(base, variant_decl.name.name, len(slots), len(values)), e.start, e.end);
        return error_expr();
    }
    let type_args: [Type] = [];
    for p in template.params {
        let Option::Some(t) = find_binding(bindings, p) else {
            // An unknown parameter that an error-typed value or context would have fixed was already reported.
            var reported: bool = expected_error;
            for v in values {
                if is_error(v.ty) {
                    reported = true;
                }
            }
            if !reported {
                report(ctx.env, "cannot infer type arguments for '" + base + "'", e.start, e.end);
            }
            return error_expr();
        };
        push(type_args, t);
    }
    let ty: Type = instantiate(ctx.env, template, type_args);
    let name: string = type_to_string(ty);
    let Option::Some(ei) = find_enum(ctx.env, name) else {
        panic("internal: missing instantiation '" + name + "'");
    };
    let Option::Some(tag) = find_tvariant(ctx.env.enums[ei].variants, variant_decl.name.name) else {
        panic("internal: instantiation '" + name + "' has no variant '" + variant_decl.name.name + "'");
    };
    let payload: [Type] = ctx.env.enums[ei].variants[tag].payload;
    for i in 0..len(values) {
        expect_type(ctx, payload[i], values[i].ty, args[i].start, args[i].end);
    }
    return TExpr { ty: ty, node: TExprNode::Variant(name, variant_decl.name.name, tag, values) };
}

// Matches a value's type against a template slot, binding each of `params` the slot fixes that is still unbound: a
// bare parameter takes the whole type, and arrays, maps, sets and instantiations of the same template are matched part
// by part.
// Error and void types bind nothing. `env` is only read, to find an instantiation's generic origin.
fn unify(env: Env, params: [string], slot: TypeExpr, actual: Type, bindings: [Binding]) {
    if is_error(actual) || is_void(actual) || is_never(actual) {
        return;
    }
    match slot.node {
        TypeNode::Array(elem) => {
            if let Type::Array(actual_elem) = actual {
                unify(env, params, elem, actual_elem, bindings);
            }
        }
        TypeNode::Named(name, slot_args) => {
            if contains(params, name) {
                if len(slot_args) == 0 {
                    if let Option::None = find_binding(bindings, name) {
                        push(bindings, Binding { name: name, ty: actual });
                    }
                }
                return;
            }
            match actual {
                Type::Map(k, v) => {
                    if name == "Map" && len(slot_args) == 2 {
                        unify(env, params, slot_args[0], k, bindings);
                        unify(env, params, slot_args[1], v, bindings);
                    }
                    return;
                }
                Type::Set(k) => {
                    if name == "Set" && len(slot_args) == 1 {
                        unify(env, params, slot_args[0], k, bindings);
                    }
                    return;
                }
                _ => {}
            }
            let Type::Enum(actual_name) = actual else {
                return;
            };
            let Option::Some(ei) = find_enum(env, actual_name) else {
                return;
            };
            let en: TEnum = env.enums[ei];
            if en.base != name || len(en.args) != len(slot_args) {
                return;
            }
            for i in 0..len(slot_args) {
                unify(env, params, slot_args[i], en.args[i], bindings);
            }
        }
    }
}

// ---- match (spec §3.3)

// The name an enum's patterns and diagnostics write: an instantiation's generic enum, or the enum itself.
fn enum_base_name(env: Env, t: Type): string {
    match t {
        Type::Enum(name) => {
            if let Option::Some(ei) = find_enum(env, name) {
                if env.enums[ei].base != "" {
                    return env.enums[ei].base;
                }
            }
            return name;
        }
        _ => {
            return type_to_string(t);
        }
    }
}

// "enum", "int", "bool" or "string" for a type a match can take apart, else "" (TS's null).
fn match_category(t: Type): string {
    let kind: string = kind_of_type(t);
    if kind == "enum" || kind == "int" || kind == "bool" || kind == "string" {
        return kind;
    }
    return "";
}

// A pattern alternative that fits the scrutinee: its key in the match's covered set, for a variant its index (its tag)
// in the scrutinee's enum, else -1, and the value it matches: the decimal value of an int, char or bool (0 or 1)
// pattern, the decoded value of a string pattern, and "" for a variant. A key holds the alternative's value, not its
// spelling: `int:<decimal>` for integer and character patterns, `bool:<b>`, `str:<value>`, `tag:<tag>`.
struct ResolvedAlt {
    key: string,
    variant: int,
    value: string,
}

// What check_arms found: the typed scrutinee and, per arm in order, the typed pattern, the typed body, and the body's
// type (an expression match) or whether it diverges (a statement match), and the scope holding the first arm's binders
// (which let-else declares again after its else block). TS's `checkArm` callback becomes the `as_expr` flag.
struct MatchArms {
    scrutinee: TExpr,
    patterns: [TPattern],
    bodies: [TArmBody],
    types: [Type],
    diverges: [bool],
    binders: [Local],
}

// A match statement. An expression arm's body becomes a block holding that expression statement.
fn check_match(ctx: Ctx, keyword: Ident, scrutinee: Expr, arms: [Arm]): CheckedStmt {
    let m: MatchArms = check_arms(ctx, keyword, scrutinee, arms, false, Option::None, Option::None);
    let typed: [TArm] = [];
    for i in 0..len(m.patterns) {
        push(typed, TArm { pattern: m.patterns[i], body: m.bodies[i] });
    }
    // Every match is exhaustive, so it ends a control path exactly when every arm does.
    var diverges: bool = len(m.diverges) > 0;
    for d in m.diverges {
        if !d {
            diverges = false;
        }
    }
    return CheckedStmt { node: TStmt::Match(m.scrutinee, typed), diverges: diverges };
}

// TS's checkMatch. Checks a match's scrutinee and patterns:
// - the scrutinee must be an enum, int, bool or string
// - each pattern alternative must fit the scrutinee's type
// - no arm may be unreachable, and no alternative may repeat a value already covered
// - an enum or bool match must cover every value unless there is a `_` arm; an int or string match needs `_`
// and checks each arm's body with that arm's binders in scope. Patterns are not checked at all against an error-typed
// or unmatchable scrutinee, and an alternative that fails to resolve switches off the exhaustiveness check. For a match
// expression (`as_expr`) `types` gets one type per arm, a block arm (which must diverge) counting as never; for a match
// statement `diverges` gets one entry per arm.
// `refutable` is set by let-else and if-let, which pass their pattern and then a synthetic wildcard, with the else
// branch that is the wildcard arm's body (TS's checkArm callback runs checkElse there, or nothing for an absent branch,
// which leaves an empty block that doesn't diverge). That wildcard is never unreachable, and a first pattern that
// covers every value is reported as `pattern always matches` instead, unless the pattern has an error of its own (any
// diagnostic from resolving it or declaring its binders).
fn check_arms(ctx: Ctx, keyword: Ident, scrutinee: Expr, arms: [Arm], as_expr: bool, expected: Option[Type], refutable: Option[Else]): MatchArms {
    let scrutinee_expr: TExpr = check_expr(ctx, scrutinee, Option::None);
    let st: Type = scrutinee_expr.ty;
    var has_decl: bool = false;
    var variants: [TVariant] = [];
    if let Type::Enum(name) = st {
        if let Option::Some(ei) = find_enum(ctx.env, name) {
            has_decl = true;
            variants = ctx.env.enums[ei].variants;
        }
    }
    if match_category(st) == "" && !is_error(st) {
        report(ctx.env, "cannot match on '" + type_to_string(st) + "' values", scrutinee.start, scrutinee.end);
    }
    let category: string = if kind_of_type(st) == "enum" && !has_decl { "" } else { match_category(st) };
    let is_refutable: bool = match refutable {
        Option::Some(_) => true,
        Option::None => false,
    };

    let covered: [string] = [];
    var wildcard_seen: bool = false;
    var all_resolved: bool = true;
    let result: MatchArms = MatchArms { scrutinee: scrutinee_expr, patterns: [], bodies: [], types: [], diverges: [], binders: [] };
    var index: int = 0;
    for arm in arms {
        let pattern: Pattern = arm.pattern;
        let is_wildcard: bool = match pattern.node {
            PatternNode::Wildcard => true,
            _ => false,
        };
        let alternatives: [Pattern] = match pattern.node {
            PatternNode::Wildcard => [],
            PatternNode::Or(alts) => alts,
            _ => [pattern],
        };
        var single: int = -1;
        var fresh: [ResolvedAlt] = [];
        let diags_before: int = len(ctx.env.diags);
        var irrefutable: bool = false;
        if category != "" {
            let resolved: [Option[ResolvedAlt]] = [];
            for alt in alternatives {
                push(resolved, resolve_alternative(ctx, st, has_decl, variants, alt));
            }
            var pattern_resolved: bool = true;
            for r in resolved {
                if let Option::None = r {
                    all_resolved = false;
                    pattern_resolved = false;
                }
            }
            if is_wildcard {
                var none_missing: bool = false;
                if let Option::Some(missing) = missing_values(ctx.env, category, st, variants, covered) {
                    none_missing = len(missing) == 0;
                }
                if !is_refutable && (wildcard_seen || none_missing) {
                    report(ctx.env, "unreachable match arm", pattern.start, pattern.end);
                }
            } else {
                fresh = check_reachability(ctx, pattern, alternatives, resolved, covered, wildcard_seen);
                for r in fresh {
                    push(covered, r.key);
                }
                if is_refutable && index == 0 && pattern_resolved {
                    if let Option::Some(missing) = missing_values(ctx.env, category, st, variants, covered) {
                        irrefutable = len(missing) == 0;
                    }
                }
            }
            if let PatternNode::Variant(_, _, _) = pattern.node {
                if let Option::Some(r) = resolved[0] {
                    single = r.variant;
                }
            }
        }
        if is_wildcard {
            wildcard_seen = true;
        }

        push(ctx.scopes, []);
        let binders: [Option[Local]] = declare_binders(ctx, pattern, variants, single);
        if irrefutable && len(ctx.env.diags) == diags_before {
            report(ctx.env, "pattern always matches", pattern.start, pattern.end);
        }
        if index == 0 {
            result.binders = ctx.scopes[len(ctx.scopes) - 1];
        }
        match arm.body {
            ArmBody::Block(b) => {
                var block: CheckedBlock = CheckedBlock { node: TBlock { stmts: [] }, diverges: false };
                if index == 0 || !is_refutable {
                    block = check_block(ctx, b);
                } else if let Option::Some(other) = refutable {
                    if has_else_branch(other) {
                        block = check_else(ctx, other);
                    }
                }
                let diverges: bool = block.diverges;
                push(result.bodies, TArmBody::Block(block.node));
                if as_expr {
                    // A match expression's block arm must diverge, and so contributes the type never.
                    if !diverges {
                        report(ctx.env, "match arm block must diverge", pattern.start, pattern.end);
                    }
                    push(result.types, Type::Never);
                } else {
                    push(result.diverges, diverges);
                }
            }
            ArmBody::Expr(body) => {
                if as_expr {
                    let checked: TExpr = check_expr(ctx, body, expected);
                    push(result.bodies, TArmBody::Expr(checked));
                    push(result.types, checked.ty);
                } else {
                    let checked: TExpr = check_expr(ctx, body, Option::None);
                    push(result.bodies, TArmBody::Block(TBlock { stmts: [TStmt::Expr(checked)] }));
                    push(result.diverges, is_never(checked.ty));
                }
            }
        }
        pop(ctx.scopes);
        push(result.patterns, typed_pattern(pattern, category, fresh, binders, variants));
        index += 1;
    }

    if category != "" && all_resolved && !wildcard_seen {
        match missing_values(ctx.env, category, st, variants, covered) {
            Option::None => report(ctx.env, "non-exhaustive match: add a '_' arm", keyword.start, keyword.end),
            Option::Some(missing) => {
                if len(missing) > 0 {
                    var list: string = "";
                    for i in 0..len(missing) {
                        if i > 0 {
                            list += ", ";
                        }
                        list += missing[i];
                    }
                    report(ctx.env, "non-exhaustive match: missing " + list, keyword.start, keyword.end);
                }
            }
        }
    }
    return result;
}

// Resolves one alternative against the scrutinee type `st`, reporting a pattern that does not fit. Returns None after
// any report. `has_decl` says whether the scrutinee is an enum, and `variants` are then its variants.
fn resolve_alternative(ctx: Ctx, st: Type, has_decl: bool, variants: [TVariant], alt: Pattern): Option[ResolvedAlt] {
    if let PatternNode::Variant(enum_name, variant_name, binders) = alt.node {
        if has_decl {
            let vi: int = resolve_pattern_variant(ctx, st, variants, alt, enum_name, variant_name, binders)?;
            return Option::Some(ResolvedAlt { key: "tag:" + int_to_string(vi), variant: vi, value: "" });
        }
        // Only the enum name matters here: any variant of it is the wrong type. Templates count as enums, and the type
        // namespace holds each name at most once.
        if type_kind_of(ctx.env, enum_name.name) == "enum" {
            report(ctx.env, "pattern type '" + enum_name.name + "' does not match '" + type_to_string(st) + "'", enum_name.start, enum_name.end);
        } else {
            resolve_variant(ctx.env, enum_name, variant_name);
        }
        return Option::None;
    }
    let pattern_type: Type = match alt.node {
        PatternNode::StringPat(_) => Type::Str,
        PatternNode::BoolPat(_) => Type::Bool,
        _ => Type::Int,
    };
    if !type_equals(pattern_type, st) {
        report(ctx.env, "pattern type '" + type_to_string(pattern_type) + "' does not match '" + type_to_string(st) + "'", alt.start, alt.end);
        return Option::None;
    }
    if let PatternNode::StringPat(text) = alt.node {
        return Option::Some(ResolvedAlt { key: "str:" + string_pattern_value(text), variant: -1, value: string_literal_value(text) });
    }
    if let PatternNode::BoolPat(b) = alt.node {
        let value: string = if b { "1" } else { "0" };
        return Option::Some(ResolvedAlt { key: if b { "bool:true" } else { "bool:false" }, variant: -1, value: value });
    }
    let value: string = match alt.node {
        PatternNode::IntPat(text) => int_pattern_value(text),
        PatternNode::CharPat(text) => int_to_string(char_pattern_value(text)),
        _ => "",
    };
    return Option::Some(ResolvedAlt { key: "int:" + value, variant: -1, value: value });
}

// An integer pattern's value in canonical decimal (TS's bigint), so `007` and `7`, and `-0` and `0`, are one key.
fn int_pattern_value(text: string): string {
    if byte_at(text, 0) != '-' {
        return canonical_digits(text);
    }
    let digits: string = canonical_digits(substring(text, 1, len(text)));
    if digits == "0" {
        return digits;
    }
    return "-" + digits;
}

// A character pattern's code, from its source text (the lexer has accepted it, so it is one ASCII character or an
// escape).
fn char_pattern_value(text: string): int {
    let c: int = byte_at(text, 1);
    if c != '\\' {
        return c;
    }
    return escape_value(byte_at(text, 2));
}

// The byte an escape `\c` stands for.
fn escape_value(c: int): int {
    return match c {
        'n' => 10,
        't' => 9,
        'r' => 13,
        '0' => 0,
        _ => c,
    };
}

// A string pattern's value, from its source text, in a form that is equal for two literals exactly when their values
// are: escapes are decoded, then a backslash is written `\\` and a NUL byte `\0`, so neither is ambiguous.
fn string_pattern_value(text: string): string {
    var out: string = "";
    var i: int = 1;
    while i < len(text) - 1 {
        var c: int = byte_at(text, i);
        var width: int = 1;
        if c == '\\' && i + 1 < len(text) - 1 {
            width = 2;
            c = escape_value(byte_at(text, i + 1));
        }
        if c == '\\' {
            out += "\\\\";
        } else if c == 0 {
            out += "\\0";
        } else if c == 10 {
            out += "\n";
        } else if c == 9 {
            out += "\t";
        } else if c == 13 {
            out += "\r";
        } else if width == 2 {
            out += substring(text, i + 1, i + 2);
        } else {
            out += substring(text, i, i + 1);
        }
        i += width;
    }
    return out;
}

// A string literal's value, from its source text (quotes included): its bytes with every escape decoded. Aster has no
// way to make a string from a byte, so an escape's byte comes from a one-byte literal; any other byte is copied as is,
// which keeps UTF-8 sequences intact.
fn string_literal_value(text: string): string {
    var out: string = "";
    var i: int = 1;
    while i < len(text) - 1 {
        let c: int = byte_at(text, i);
        if c == '\\' && i + 1 < len(text) - 1 {
            out += match byte_at(text, i + 1) {
                'n' => "\n",
                't' => "\t",
                'r' => "\r",
                '0' => "\0",
                '\\' => "\\",
                '"' => "\"",
                '\'' => "'",
                _ => substring(text, i + 1, i + 2),
            };
            i += 2;
        } else {
            out += substring(text, i, i + 1);
            i += 1;
        }
    }
    return out;
}

// Reports an arm whose every resolved alternative is already covered (or that follows `_`) as unreachable, and
// otherwise each covered alternative as a duplicate. Returns the alternatives that cover something new.
fn check_reachability(ctx: Ctx, pattern: Pattern, alternatives: [Pattern], resolved: [Option[ResolvedAlt]], covered: [string], wildcard_seen: bool): [ResolvedAlt] {
    let fresh: [ResolvedAlt] = [];
    let stale: [Pattern] = [];
    let arm_keys: [string] = [];
    for i in 0..len(resolved) {
        if let Option::Some(r) = resolved[i] {
            if contains(covered, r.key) || contains(arm_keys, r.key) {
                push(stale, alternatives[i]);
            } else {
                push(arm_keys, r.key);
                push(fresh, r);
            }
        }
    }
    if len(fresh) + len(stale) == 0 {
        return fresh;
    }
    if wildcard_seen || len(fresh) == 0 {
        report(ctx.env, "unreachable match arm", pattern.start, pattern.end);
    } else {
        for alt in stale {
            report(ctx.env, "duplicate pattern alternative", alt.start, alt.end);
        }
    }
    return fresh;
}

// The values a match on `category` has not yet covered, in the form the non-exhaustive message lists them; None for
// int and string, whose values can never all be covered.
fn missing_values(env: Env, category: string, st: Type, variants: [TVariant], covered: [string]): Option[[string]] {
    let missing: [string] = [];
    if category == "enum" {
        for i in 0..len(variants) {
            if !contains(covered, "tag:" + int_to_string(i)) {
                push(missing, "'" + enum_base_name(env, st) + "::" + variants[i].name + "'");
            }
        }
        return Option::Some(missing);
    }
    if category == "bool" {
        for b in ["true", "false"] {
            if !contains(covered, "bool:" + b) {
                push(missing, "'" + b + "'");
            }
        }
        return Option::Some(missing);
    }
    return Option::None;
}

// Declares a single variant pattern's binders in the current scope, typed by the payload of variant `vi` (an index into
// `variants`, or -1) when the binder count is right. Named binders in an or-pattern are reported and not declared.
// Returns one local per binder of a variant pattern (None for `_` and for a repeated name), else none.
fn declare_binders(ctx: Ctx, pattern: Pattern, variants: [TVariant], vi: int): [Option[Local]] {
    let locals: [Option[Local]] = [];
    match pattern.node {
        PatternNode::Or(alts) => {
            for alt in alts {
                if let PatternNode::Variant(_, _, binders) = alt.node {
                    for binder in binders {
                        if let Binder::Named(id) = binder {
                            report(ctx.env, "or-pattern alternatives cannot bind names", id.start, id.end);
                        }
                    }
                }
            }
        }
        PatternNode::Variant(_, _, binders) => {
            var slots: [Type] = [];
            var has_slots: bool = false;
            if vi >= 0 && len(binders) == len(variants[vi].payload) {
                slots = variants[vi].payload;
                has_slots = true;
            }
            let seen: [string] = [];
            for i in 0..len(binders) {
                let Binder::Named(id) = binders[i] else {
                    push(locals, Option::None);
                    continue;
                };
                if contains(seen, id.name) {
                    report(ctx.env, "duplicate binding '" + id.name + "'", id.start, id.end);
                    push(locals, Option::None);
                } else {
                    push(seen, id.name);
                    let ty: Type = if has_slots { slots[i] } else { Type::Error };
                    push(locals, Option::Some(declare(ctx, id, ty, false)));
                }
            }
        }
        _ => {}
    }
    return locals;
}

// The typed form of an arm's pattern, from the alternatives it newly covers (`fresh`) and its binders. `variants` are
// the scrutinee enum's variants, which name a fresh variant alternative by its index.
fn typed_pattern(pattern: Pattern, category: string, fresh: [ResolvedAlt], binders: [Option[Local]], variants: [TVariant]): TPattern {
    if let PatternNode::Wildcard = pattern.node {
        return TPattern::Wildcard;
    }
    if category == "int" || category == "bool" {
        let values: [string] = [];
        for r in fresh {
            push(values, r.value);
        }
        return TPattern::Ints(values);
    }
    if category == "string" {
        let values: [string] = [];
        for r in fresh {
            push(values, r.value);
        }
        return TPattern::Strings(values);
    }
    let refs: [TVariantRef] = [];
    for r in fresh {
        if r.variant >= 0 {
            push(refs, TVariantRef { name: variants[r.variant].name, tag: r.variant });
        }
    }
    let kept: [Option[Local]] = if len(refs) == 1 { binders } else { [] };
    return TPattern::Variants(refs, kept);
}

// Resolves `F::V(...)` against the scrutinee's enum (whose variants are `variants`), returning the variant's index.
// Returns None after reporting an unknown or wrong enum or an unknown variant. A wrong binder count is reported, but the
// variant is still returned, so it still counts as covered.
fn resolve_pattern_variant(ctx: Ctx, st: Type, variants: [TVariant], alt: Pattern, enum_name: Ident, variant_name: Ident, binders: [Binder]): Option[int] {
    // Patterns never carry type arguments, so a pattern names an instantiation by its generic enum's name.
    let base: string = enum_base_name(ctx.env, st);
    if enum_name.name != base {
        match resolve_variant(ctx.env, enum_name, variant_name) {
            FoundVariant::Missing => {}
            _ => report(ctx.env, "pattern type '" + enum_name.name + "' does not match '" + type_to_string(st) + "'", enum_name.start, enum_name.end),
        }
        return Option::None;
    }
    let Option::Some(vi) = find_tvariant(variants, variant_name.name) else {
        report(ctx.env, "unknown variant '" + variant_name.name + "' on '" + base + "'", variant_name.start, variant_name.end);
        return Option::None;
    };
    let payload: [Type] = variants[vi].payload;
    if len(binders) != len(payload) {
        report(ctx.env, variant_arity_message(base, variants[vi].name, len(payload), len(binders)), alt.start, alt.end);
    }
    return Option::Some(vi);
}

// A match expression.
fn check_match_expr(ctx: Ctx, e: Expr, keyword: Ident, scrutinee: Expr, arms: [Arm], expected: Option[Type]): TExpr {
    let m: MatchArms = check_arms(ctx, keyword, scrutinee, arms, true, expected, Option::None);
    for t in m.types {
        if is_error(t) {
            return error_expr();
        }
    }
    // The parser guarantees at least one arm. Arms of type never (block arms among them) don't take part in the "same
    // type" rule; the expression is never only if every arm is.
    var ty: Type = Type::Never;
    for t in m.types {
        if !is_never(t) {
            ty = t;
            break;
        }
    }
    for t in m.types {
        if !is_never(t) && !type_equals(t, ty) {
            report(ctx.env, "match arms have different types: " + type_to_string(ty) + " and " + type_to_string(t), e.start, e.end);
            return error_expr();
        }
    }
    if is_void(ty) {
        report(ctx.env, "match expression cannot have type void", e.start, e.end);
        return error_expr();
    }
    if match_category(m.scrutinee.ty) == "" {
        return error_expr();
    }
    let typed: [TArm] = [];
    for i in 0..len(m.patterns) {
        push(typed, TArm { pattern: m.patterns[i], body: m.bodies[i] });
    }
    return TExpr { ty: ty, node: TExprNode::Match(m.scrutinee, typed) };
}

fn find_field(env: Env, struct_name: string, name: string): Option[TField] {
    let fields: [TField] = env.structs[find_struct(env, struct_name)?].fields;
    return Option::Some(fields[find_tfield(fields, name)?]);
}

// Struct, array, map and set values are heap references; no equality is defined for them.
fn is_reference(t: Type): bool {
    return match t {
        Type::Struct(_) => true,
        Type::Array(_) => true,
        Type::Map(_, _) => true,
        Type::Set(_) => true,
        _ => false,
    };
}

fn check_struct_lit(ctx: Ctx, name: Ident, inits: [FieldInit]): TExpr {
    let Option::Some(si) = find_struct(ctx.env, name.name) else {
        report(ctx.env, "unknown struct '" + name.name + "'", name.start, name.end);
        // Still check the values so their own errors surface; the `error` type keeps an `[]` value from being
        // reported as uninferable.
        for init in inits {
            check_expr(ctx, init.value, Option::Some(Type::Error));
        }
        return error_expr();
    };
    let st: TStruct = ctx.env.structs[si];
    // The fields initialised so far, in the order written.
    let fields: [TFieldInit] = [];
    for init in inits {
        let decl: Option[TField] = find_field(ctx.env, st.name, init.name.name);
        let field_type: Type = match decl {
            Option::Some(f) => f.ty,
            Option::None => Type::Error,
        };
        let value: TExpr = check_expr(ctx, init.value, Option::Some(field_type));
        match decl {
            Option::None => {
                report(ctx.env, "unknown field '" + init.name.name + "' on '" + name.name + "'", init.name.start, init.name.end);
            }
            Option::Some(f) => {
                if has_field_init(fields, init.name.name) {
                    report(ctx.env, "duplicate field '" + init.name.name + "'", init.name.start, init.name.end);
                } else {
                    expect_type(ctx, f.ty, value.ty, init.value.start, init.value.end);
                    push(fields, TFieldInit { field: init.name.name, value: value });
                }
            }
        }
    }
    for f in st.fields {
        if !has_field_init(fields, f.name) {
            report(ctx.env, "missing field '" + f.name + "' in '" + name.name + "'", name.start, name.end);
        }
    }
    return TExpr { ty: Type::Struct(st.name), node: TExprNode::StructLit(st.name, fields) };
}

fn has_field_init(fields: [TFieldInit], name: string): bool {
    for f in fields {
        if f.field == name {
            return true;
        }
    }
    return false;
}

fn check_array_lit(ctx: Ctx, e: Expr, elements: [Expr], expected: Option[Type]): TExpr {
    var elem: Option[Type] = Option::None;
    if let Option::Some(t) = expected {
        if is_error(t) {
            // The expected type was already reported as wrong; only look for errors inside the elements.
            for el in elements {
                check_expr(ctx, el, Option::Some(Type::Error));
            }
            return error_expr();
        }
        if let Type::Array(x) = t {
            elem = Option::Some(x);
        }
    }
    if len(elements) == 0 {
        let Option::Some(x) = elem else {
            report(ctx.env, "cannot infer type of empty array", e.start, e.end);
            return error_expr();
        };
        return TExpr { ty: Type::Array(x), node: TExprNode::ArrayLit([]) };
    }
    let values: [TExpr] = [];
    for el in elements {
        let value: TExpr = check_expr(ctx, el, elem);
        match elem {
            Option::None => {
                // Without an expected type, the first element that isn't never decides.
                if is_never(value.ty) {
                    push(values, value);
                    continue;
                }
                if is_void(value.ty) {
                    report(ctx.env, "array element cannot have type void", el.start, el.end);
                    return error_expr();
                }
                elem = Option::Some(value.ty);
            }
            Option::Some(x) => {
                expect_type(ctx, x, value.ty, el.start, el.end);
            }
        }
        push(values, value);
    }
    let Option::Some(x) = elem else {
        report(ctx.env, "cannot infer type of empty array", e.start, e.end);
        return error_expr();
    };
    if is_error(x) {
        return error_expr();
    }
    return TExpr { ty: Type::Array(x), node: TExprNode::ArrayLit(values) };
}

// `{}` takes its type from `expected`, which must be a map or a set.
fn check_empty_map(ctx: Ctx, e: Expr, expected: Option[Type]): TExpr {
    let Option::Some(t) = expected else {
        report(ctx.env, "cannot infer type of empty map or set", e.start, e.end);
        return error_expr();
    };
    match t {
        Type::Map(_, _) => {
            return TExpr { ty: t, node: TExprNode::EmptyMap };
        }
        Type::Set(_) => {
            return TExpr { ty: t, node: TExprNode::EmptyMap };
        }
        Type::Error => {
            return error_expr();
        }
        _ => {
            report(ctx.env, "type mismatch: expected " + type_to_string(t) + ", found empty map or set", e.start, e.end);
            return error_expr();
        }
    }
}

// Resolves an assignment target, or None once it has been reported. Only a bare local needs to be `var`; writing
// through a field or an element is always allowed, because `let` only fixes the binding, not the object it refers to.
fn check_place(ctx: Ctx, target: Expr): Option[TPlace] {
    match target.node {
        ExprNode::Name(name) => {
            let Option::Some(local) = lookup(ctx, name) else {
                let message: string = if is_function_name(ctx, name) { "cannot assign to function '" + name + "'" } else { "undefined name '" + name + "'" };
                report(ctx.env, message, target.start, target.end);
                return Option::None;
            };
            if !local.mutable {
                report(ctx.env, "cannot assign to immutable variable '" + name + "'", target.start, target.end);
            }
            return Option::Some(TPlace { ty: local.ty, node: TPlaceNode::Local(local) });
        }
        ExprNode::Field(_, _) | ExprNode::Index(_, _) => {
            let checked: TExpr = check_expr(ctx, target, Option::None);
            return match checked.node {
                TExprNode::Field(object, field) => Option::Some(TPlace { ty: checked.ty, node: TPlaceNode::Field(object, field) }),
                TExprNode::Index(array, index) => Option::Some(TPlace { ty: checked.ty, node: TPlaceNode::Index(array, index) }),
                // already reported
                _ => Option::None,
            };
        }
        _ => {
            report(ctx.env, "invalid assignment target", target.start, target.end);
            return Option::None;
        }
    }
}

// `s` is the assignment `target op value`, with `op` a compound operator such as `+=`.
fn check_compound(ctx: Ctx, s: Stmt, op: string, target: Type, value: Type) {
    if op == "=" || is_error(target) || is_error(value) {
        return;
    }
    let applies: bool = match binary_result_type(substring(op, 0, len(op) - 1), target, value) {
        Option::Some(result) => type_equals(result, target),
        Option::None => false,
    };
    if !applies {
        report(ctx.env, "operator '" + op + "' cannot be applied to " + type_to_string(target) + " and " + type_to_string(value), s.start, s.end);
    }
}

fn binary_result_type(op: string, left: Type, right: Type): Option[Type] {
    let same: bool = type_equals(left, right);
    let l: string = kind_of_type(left);
    let r: string = kind_of_type(right);
    match op {
        "+" => {
            if same && (l == "int" || l == "string") {
                return Option::Some(left);
            }
        }
        "-" | "*" | "/" | "%" => {
            if l == "int" && r == "int" {
                return Option::Some(Type::Int);
            }
        }
        "<" | "<=" | ">" | ">=" => {
            if l == "int" && r == "int" {
                return Option::Some(Type::Bool);
            }
        }
        "==" | "!=" => {
            if same && l != "void" {
                return Option::Some(Type::Bool);
            }
        }
        "&&" | "||" => {
            if l == "bool" && r == "bool" {
                return Option::Some(Type::Bool);
            }
        }
        _ => {}
    }
    return Option::None;
}

fn check_binary(ctx: Ctx, e: Expr, op: string, left_expr: Expr, right_expr: Expr): TExpr {
    let left: TExpr = check_expr(ctx, left_expr, Option::None);
    let right: TExpr = check_expr(ctx, right_expr, Option::None);
    if is_error(left.ty) || is_error(right.ty) {
        return error_expr();
    }
    if is_never(left.ty) || is_never(right.ty) {
        report(ctx.env, "operator '" + op + "' cannot be applied to " + type_to_string(left.ty) + " and " + type_to_string(right.ty), e.start, e.end);
        return error_expr();
    }
    if (op == "==" || op == "!=") && type_equals(left.ty, right.ty) {
        var is_enum: bool = false;
        var payload_free_enum: bool = false;
        if let Type::Enum(name) = left.ty {
            is_enum = true;
            if let Option::Some(i) = find_enum(ctx.env, name) {
                payload_free_enum = ctx.env.enums[i].payload_free;
            }
        }
        if is_reference(left.ty) || (is_enum && !payload_free_enum) {
            report(ctx.env, "cannot compare '" + type_to_string(left.ty) + "' values", e.start, e.end);
            return error_expr();
        }
        if payload_free_enum {
            return TExpr { ty: Type::Bool, node: TExprNode::EnumCompare(op, left, right) };
        }
    }
    let Option::Some(t) = binary_result_type(op, left.ty, right.ty) else {
        report(ctx.env, "operator '" + op + "' cannot be applied to " + type_to_string(left.ty) + " and " + type_to_string(right.ty), e.start, e.end);
        return error_expr();
    };
    return TExpr { ty: t, node: TExprNode::Binary(op, left, right) };
}

fn arity_message(name: string, expected: int, found: int): string {
    let noun: string = if expected == 1 { "argument" } else { "arguments" };
    return "function '" + name + "' expects " + int_to_string(expected) + " " + noun + ", found " + int_to_string(found);
}

// checkCall's `checkArgs`. Only used once a problem with the call itself has been reported (or the signature is
// known): the `error` type keeps `[]` arguments from cascading. Calls nothing has complained about yet must not use
// it.
fn check_args(ctx: Ctx, args: [Expr], params: Option[[Type]]): [TExpr] {
    let values: [TExpr] = [];
    for i in 0..len(args) {
        var expected: Type = Type::Error;
        if let Option::Some(ps) = params {
            if i < len(ps) {
                expected = ps[i];
            }
        }
        push(values, check_expr(ctx, args[i], Option::Some(expected)));
    }
    return values;
}

fn check_call(ctx: Ctx, e: Expr, callee: Expr, args: [Expr]): TExpr {
    let ExprNode::Name(name) = callee.node else {
        check_args(ctx, args, Option::None);
        report(ctx.env, "only named functions can be called", callee.start, callee.end);
        return error_expr();
    };
    if let Option::Some(_) = lookup(ctx, name) {
        check_args(ctx, args, Option::None);
        report(ctx.env, "'" + name + "' is not a function", callee.start, callee.end);
        return error_expr();
    }
    if name == "print" || name == "eprint" {
        // A wrong argument count is reported by check_print; its arguments must not cascade then.
        let values: [TExpr] = [];
        for a in args {
            let expected: Option[Type] = if len(args) == 1 { Option::None } else { Option::Some(Type::Error) };
            push(values, check_expr(ctx, a, expected));
        }
        return check_print(ctx, e, name, args, values);
    }
    if name == "len" || name == "push" || name == "pop" {
        return check_collection_builtin(ctx, name, e, args);
    }

    // A builtin's signature, else the user function's.
    let builtins: [Signature] = builtin_signatures();
    var sigs: [Signature] = ctx.signatures;
    var builtin: bool = false;
    if let Option::Some(_) = find_signature(builtins, name) {
        sigs = builtins;
        builtin = true;
    }
    let Option::Some(si) = find_signature(sigs, name) else {
        check_args(ctx, args, Option::None);
        report(ctx.env, "undefined function '" + name + "'", callee.start, callee.end);
        return error_expr();
    };
    let sg: Signature = sigs[si];
    let values: [TExpr] = check_args(ctx, args, Option::Some(sg.params));
    if len(values) != len(sg.params) {
        report(ctx.env, arity_message(name, len(sg.params), len(values)), e.start, e.end);
    } else {
        for i in 0..len(values) {
            expect_type(ctx, sg.params[i], values[i].ty, args[i].start, args[i].end);
        }
    }
    var ret: Type = sg.ret;
    if let Option::Some(ok) = builtin_result_ok(name) {
        let Option::Some(ti) = find_template(ctx.env, "Result") else {
            panic("internal: no Result template");
        };
        ret = instantiate(ctx.env, ctx.env.templates[ti], [ok, Type::Str]);
    }
    if builtin {
        return TExpr { ty: ret, node: TExprNode::Builtin(name, values) };
    }
    return TExpr { ty: ret, node: TExprNode::Call(name, values) };
}

// read_file and the four POSIX builtins return a Result the checker builds by hand; this is its Ok type, or None for
// every other builtin (builtinReturnType).
fn builtin_result_ok(name: string): Option[Type] {
    if name == "read_file" || name == "make_temp_dir" {
        return Option::Some(Type::Str);
    }
    if name == "write_file" || name == "remove_path" || name == "run_process" {
        return Option::Some(Type::Int);
    }
    return Option::None;
}

// `name` is print or eprint; `values` are the checked `args`.
fn check_print(ctx: Ctx, e: Expr, name: string, args: [Expr], values: [TExpr]): TExpr {
    if len(values) != 1 {
        report(ctx.env, arity_message(name, 1, len(values)), e.start, e.end);
        return error_expr();
    }
    let t: Type = values[0].ty;
    let k: string = kind_of_type(t);
    if !is_error(t) && k != "int" && k != "bool" && k != "string" {
        report(ctx.env, "cannot print a value of type " + type_to_string(t), args[0].start, args[0].end);
    }
    return TExpr { ty: Type::Void, node: TExprNode::Builtin(name, values) };
}

// `len` (string or array), `push` and `pop` (any array). Typed by hand because they work on any array.
fn check_collection_builtin(ctx: Ctx, name: string, e: Expr, args: [Expr]): TExpr {
    let values: [TExpr] = [];
    var t: Type = Type::Error;
    if len(args) > 0 {
        let first: TExpr = check_expr(ctx, args[0], Option::None);
        push(values, first);
        t = first.ty;
    }
    var elem: Option[Type] = Option::None;
    if let Type::Array(x) = t {
        elem = Option::Some(x);
    }
    // When the first argument is not an array it is reported below (or already was), so the rest must not cascade.
    let rest_expected: Type = match elem {
        Option::Some(x) => x,
        Option::None => Type::Error,
    };
    for i in 1..len(args) {
        push(values, check_expr(ctx, args[i], Option::Some(rest_expected)));
    }
    let arity: int = if name == "push" { 2 } else { 1 };
    if len(args) == 0 || len(args) != arity {
        report(ctx.env, arity_message(name, arity, len(args)), e.start, e.end);
        return error_expr();
    }
    if name == "len" {
        let k: string = kind_of_type(t);
        if !is_error(t) && k != "string" && k != "array" {
            report(ctx.env, "function 'len' expects a string or array, found " + type_to_string(t), args[0].start, args[0].end);
        }
        // len is an int whatever its argument, so a bad argument doesn't cascade.
        return TExpr { ty: Type::Int, node: TExprNode::Builtin("len", values) };
    }
    let Option::Some(x) = elem else {
        if !is_error(t) {
            report(ctx.env, "function '" + name + "' expects an array, found " + type_to_string(t), args[0].start, args[0].end);
        }
        return error_expr();
    };
    if name == "push" {
        expect_type(ctx, x, values[1].ty, args[1].start, args[1].end);
        return TExpr { ty: Type::Void, node: TExprNode::Builtin("push", values) };
    }
    return TExpr { ty: x, node: TExprNode::Builtin("pop", values) };
}
