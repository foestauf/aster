{
  "name": "aster",
  "version": "0.0.0",
  "private": true,
  "description": "Aster: a small statically typed, compiled language, self-hosted",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-compiler.ts build",
    "bootstrap": "node scripts/build-compiler.ts bootstrap",
    "release": "node scripts/release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "aster": "sh scripts/aster",
    "gen:runtime": "node scripts/gen-runtime.ts",
    "selfhost": "node scripts/selfhost.ts",
    "prepare": "husky",
    "golden": "vitest run -u tests/check_aster.test.ts tests/asterc_self.test.ts",
    "bench": "node scripts/bench.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
