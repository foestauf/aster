{
  "name": "aster",
  "version": "0.0.0",
  "private": true,
  "description": "Aster: a small statically typed, compiled language, bootstrapped in TypeScript",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter asterc build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
