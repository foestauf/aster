struct Point {
    x: int,
}

fn falls_through(o: Option[int]): int {
    let Option::Some(v) = o else {
        print(0);
    };
    return v;
}

fn wrong_type(o: Option[int]): int {
    let Result::Ok(v) = o else {
        return 0;
    };
    let 1 = "one" else {
        return 0;
    };
    return v;
}

fn wrong_arity(o: Option[int]): int {
    let Option::Some(a, b) = o else {
        return 0;
    };
    return a + b;
}

fn struct_scrutinee(p: Point): int {
    let Option::Some(v) = p else {
        return 0;
    };
    return v;
}

fn main(): int {
    return 0;
}
