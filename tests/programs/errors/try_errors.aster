fn on_int(x: int): Option[int] { return Option::Some(x?); }
fn in_void(o: Option[int]) { o?; }
fn r_in_o(r: Result[int, string]): Option[int] { return Option::Some(r?); }
fn o_in_r(o: Option[int]): Result[int, string] { return Result::Ok(o?); }
fn mismatch(r: Result[int, int]): Result[int, string] { return Result::Ok(r?); }
fn main(): int { let o: Option[int] = Option::None; let x: int = o?; return x; }
