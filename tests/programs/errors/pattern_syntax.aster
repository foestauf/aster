// A pattern syntax error abandons the match statement mid-arm, so recovery closes the function body at the arm's
// `}` and the function's own `}` is reported as a stray token. Each case therefore gets its own function.
fn a(x: int) { match x { _ | 1 => {} } }
fn b(x: int) { match x { 1 | _ => {} } }
fn c(x: int) { match x { ( => {} } }
fn d(x: int) { match x { -'a' => {} } }
