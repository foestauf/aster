// `read_file(path)?` propagates the read error as the function's Err.
// expect-stderr: /nonexistent/x: No such file or directory
// expect-exit: 1
fn load(path: string): Result[int, string] {
    let t: string = read_file(path)?;
    return Result::Ok(len(t));
}

fn main(): int {
    match load("/nonexistent/x") {
        Result::Ok(n) => print(n),
        Result::Err(e) => {
            eprint(e);
            return 1;
        }
    }
    return 0;
}
