// 100 000 insertions grow the table through many resizes; removing every even key leaves tombstones to compact,
// and insertion order survives both.
// expect-stdout:
// 100000
// 50000
// 2500000000
// 1
// 99999
// 299997
// false
// 50001
// 0
fn main(): int {
    let m: Map[int, int] = {};
    for k in 0..100000 {
        map_set(m, k, k * 3);
    }
    print(len(m));
    for k in 0..50000 {
        map_remove(m, k * 2);
    }
    print(len(m));
    let ks: [int] = map_keys(m);
    var sum: int = 0;
    for k in ks {
        sum += k;
    }
    print(sum);
    print(ks[0]);
    print(ks[len(ks) - 1]);
    if let Option::Some(v) = map_get(m, 99999) {
        print(v);
    }
    print(map_has(m, 50000));
    map_set(m, 0, 0);
    print(len(m));
    let again: [int] = map_keys(m);
    print(again[len(again) - 1]);
    return 0;
}
