// The Aster type checker, written in Aster. It loads the program rooted at the file named by its only argument, with
// every file it imports, and type-checks it. Diagnostics go to stderr, one per line, `error <path> <start> <end>
// <message>`, sorted by position and exiting with status 1 if there are any. `<path>` is the file the diagnostic
// starts in, as the import that loaded it spelled it, and the offsets are bytes from the start of that file (a byte
// order mark included). With no diagnostics it prints a summary of the typed program to stdout: each struct with its
// fields, each enum (the generic instantiations by their type, `Option[int]`) with its variants, and each function
// with its signature and then its locals, as `param`, `let` or `var`, in id order. tests/check_aster.test.ts checks
// it against the compiler's own front end on every golden program.
// expect-args: fixtures/check_small.txt
// expect-stdout:
// struct Point
//   field x int
//   field y int
// enum Color
//   variant Red
//   variant Green
// enum Option[int]
//   variant Some(int)
//   variant None
// fn main(): int
//   let 0 p Point
//   let 1 c Color
//   let 2 o Option[int]
//   var 3 n int

import "../../../packages/asterc-self/loader.aster";
import "../../../packages/asterc-self/checker.aster";
import "../../../packages/asterc-self/report.aster";

// ---- summary

// The types of `types`, written as in source and separated by `, `.
fn type_list(types: [Type]): string {
    var out: string = "";
    for i in 0..len(types) {
        if i > 0 {
            out += ", ";
        }
        out += type_to_string(types[i]);
    }
    return out;
}

// Structs with their fields, enums with their variants, then functions with their signatures and locals.
fn print_summary(c: Checked) {
    for s in c.structs {
        print("struct " + s.name);
        for f in s.fields {
            print("  field " + f.name + " " + type_to_string(f.ty));
        }
    }
    for e in c.enums {
        print("enum " + e.name);
        for v in e.variants {
            if len(v.payload) == 0 {
                print("  variant " + v.name);
            } else {
                print("  variant " + v.name + "(" + type_list(v.payload) + ")");
            }
        }
    }
    for f in c.functions {
        let params: [Type] = [];
        for i in 0..f.params {
            push(params, f.locals[i].ty);
        }
        print("fn " + f.name + "(" + type_list(params) + "): " + type_to_string(f.ret));
        for l in f.locals {
            var kind: string = "let";
            if l.id < f.params {
                kind = "param";
            } else if l.mutable {
                kind = "var";
            }
            print("  " + kind + " " + int_to_string(l.id) + " " + l.name + " " + type_to_string(l.ty));
        }
    }
}

// ---- driver

// Prints `msg` to stderr and exits with status 2, for a usage or read error.
fn die(msg: string): never {
    eprint(msg);
    exit(2);
}

fn main(args: [string]): int {
    if len(args) != 1 {
        die("usage: check <file>");
    }
    match read_file(args[0]) {
        Result::Ok(src) => {
            let loaded: Loaded = load_program(args[0], src);
            if len(loaded.diags) > 0 {
                print_diags(loaded.files, sort_diags(loaded.diags));
                exit(1);
            }
            let checked: Checked = check_program(loaded.items, loaded.root_end);
            if len(checked.diags) > 0 {
                print_diags(loaded.files, sort_diags(checked.diags));
                exit(1);
            }
            print_summary(checked);
            return 0;
        }
        Result::Err(msg) => die(msg),
    }
}
