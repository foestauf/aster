// A first sniff of self-hosting: a tiny lexer written in Aster.
// expect-stdout:
// ident let
// ident x1
// punct :
// ident int
// punct =
// int 42
// punct +
// ident y
// punct ;
// 9 tokens
fn is_digit(c: int): bool {
    return c >= 48 && c <= 57;
}

fn is_alpha(c: int): bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_space(c: int): bool {
    return c == 32 || c == 9 || c == 10;
}

fn tokenize(src: string): int {
    var i: int = 0;
    var count: int = 0;
    let n: int = len(src);
    while i < n {
        let c: int = byte_at(src, i);
        if is_space(c) {
            i = i + 1;
            continue;
        }
        let start: int = i;
        var kind: string = "punct";
        if is_digit(c) {
            kind = "int";
            while i < n && is_digit(byte_at(src, i)) {
                i = i + 1;
            }
        } else if is_alpha(c) {
            kind = "ident";
            while i < n && (is_alpha(byte_at(src, i)) || is_digit(byte_at(src, i))) {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
        print(kind + " " + substring(src, start, i));
        count = count + 1;
    }
    return count;
}

fn main(): int {
    let total: int = tokenize("let x1: int = 42 + y;");
    print(int_to_string(total) + " tokens");
    return 0;
}
