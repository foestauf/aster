// The Aster lexer, written in Aster. It lexes the file named by its only argument and prints one line per token,
// `<kind> <start> <end> <text>`, ending with `eof <n> <n>`, and writes one line per lexical error to stderr,
// `error <start> <end> <message>`, exiting with status 1 if there were any. Offsets are in bytes.
// tests/lex_aster.test.ts checks it against the compiler's own lexer on every golden program.
// expect-args: fixtures/lex_sample.txt
// expect-stdout:
// fn 0 2 fn
// ident 3 7 main
// ( 7 8 (
// ) 8 9 )
// : 9 10 :
// ident 11 14 int
// { 15 16 {
// let 21 24 let
// ident 25 26 s
// : 26 27 :
// ident 28 34 string
// = 35 36 =
// string 37 42 "a\n"
// ; 42 43 ;
// return 54 60 return
// ident 61 62 E
// :: 62 64 ::
// ident 64 65 V
// ( 65 66 (
// ident 66 68 _x
// ) 68 69 )
// => 70 72 =>
// int 73 74 1
// .. 74 76 ..
// int 76 77 2
// != 78 80 !=
// _ 81 82 _
// ; 82 83 ;
// } 84 85 }
// eof 86 86
import "../../../packages/asterc-self/lexer.aster";


// Prints every token to stdout and every error to stderr, one per line, then exits with status 1 if there were errors.
fn report(lx: Lexer) {
    for t in lx.tokens {
        let span: string = int_to_string(t.start) + " " + int_to_string(t.end);
        if t.kind == "eof" {
            print("eof " + span);
        } else {
            print(t.kind + " " + span + " " + substring(lx.src, t.start, t.end));
        }
    }
    for e in lx.errors {
        eprint("error " + int_to_string(e.start) + " " + int_to_string(e.end) + " " + e.message);
    }
    if len(lx.errors) > 0 {
        exit(1);
    }
}

// Prints `msg` to stderr and exits with status 2, for a usage or read error.
fn die(msg: string): never {
    eprint(msg);
    exit(2);
}

fn main(args: [string]): int {
    if len(args) != 1 {
        die("usage: lex <file>");
    }
    match read_file(args[0]) {
        Result::Ok(src) => {
            report(lex(src));
            return 0;
        }
        Result::Err(msg) => die(msg),
    }
}
