// The Aster parser, written in Aster. It parses the file named by its only argument and prints the syntax tree, one
// node per line, indented two spaces per level: `<tag> <start> <end> <attributes>`, with `-` for an absent optional
// child. It writes one line per lexical or syntax error to stderr, `error <start> <end> <message>`, exiting with status
// 1 if there were any. Offsets are in bytes. tests/parse_aster.test.ts checks it against the compiler's own parser on
// every golden program.
// expect-args: fixtures/parse_small.txt
// expect-stdout:
// fn 0 45 main 3 7
//   type 11 14 int
//   block 15 45
//     let 17 33 x 21 22
//       type 24 27 int
//       int 30 32 10
//     return 34 43
//       name 41 42 x

import "../../../packages/asterc-self/parser.aster";

// ---- printer: one line per node, indented two spaces per level

fn line(depth: int, s: string) {
    var pad: string = "";
    for _i in 0..depth {
        pad += "  ";
    }
    print(pad + s);
}

fn span(start: int, end: int): string {
    return int_to_string(start) + " " + int_to_string(end);
}

// `name start end`, the form an Ident takes after a node's own span.
fn named(i: Ident): string {
    return i.name + " " + span(i.start, i.end);
}

// `start end name`, the form a node takes when the Ident is the node.
fn ident_node(tag: string, i: Ident): string {
    return tag + " " + span(i.start, i.end) + " " + i.name;
}

fn print_type(d: int, t: TypeExpr) {
    match t.node {
        TypeNode::Named(name, args) => {
            line(d, "type " + span(t.start, t.end) + " " + name);
            for a in args {
                print_type(d + 1, a);
            }
        }
        TypeNode::Array(elem) => {
            line(d, "array-type " + span(t.start, t.end));
            print_type(d + 1, elem);
        }
    }
}

fn print_pattern(d: int, pat: Pattern) {
    match pat.node {
        PatternNode::Wildcard => line(d, "wildcard " + span(pat.start, pat.end)),
        PatternNode::Variant(enum_name, variant, binders) => {
            line(d, "pattern " + span(pat.start, pat.end) + " " + named(enum_name) + " " + named(variant));
            for b in binders {
                match b {
                    Binder::Wild => line(d + 1, "_"),
                    Binder::Named(name) => line(d + 1, ident_node("bind", name)),
                }
            }
        }
        PatternNode::Or(alternatives) => {
            line(d, "or-pattern " + span(pat.start, pat.end));
            for alt in alternatives {
                print_pattern(d + 1, alt);
            }
        }
        PatternNode::IntPat(raw) => line(d, "int-pattern " + span(pat.start, pat.end) + " " + raw),
        PatternNode::CharPat(raw) => line(d, "char-pattern " + span(pat.start, pat.end) + " " + raw),
        PatternNode::StringPat(raw) => line(d, "string-pattern " + span(pat.start, pat.end) + " " + raw),
        PatternNode::BoolPat(value) => {
            if value {
                line(d, "bool-pattern " + span(pat.start, pat.end) + " true");
            } else {
                line(d, "bool-pattern " + span(pat.start, pat.end) + " false");
            }
        }
    }
}

fn print_arms(src: string, d: int, arms: [Arm]) {
    for arm in arms {
        line(d, "arm");
        print_pattern(d + 1, arm.pattern);
        match arm.body {
            ArmBody::Block(b) => print_block(src, d + 1, b),
            ArmBody::Expr(e) => print_expr(src, d + 1, e),
        }
    }
}

fn print_exprs(src: string, d: int, exprs: [Expr]) {
    for e in exprs {
        print_expr(src, d, e);
    }
}

fn print_expr(src: string, d: int, e: Expr) {
    let head: string = span(e.start, e.end);
    match e.node {
        ExprNode::Int(value) => line(d, "int " + head + " " + value),
        ExprNode::Char(raw) => line(d, "char " + head + " " + raw),
        ExprNode::Str(_) => line(d, "string " + head + " " + substring(src, e.start, e.end)),
        ExprNode::Bool(value) => {
            if value {
                line(d, "bool " + head + " true");
            } else {
                line(d, "bool " + head + " false");
            }
        }
        ExprNode::Name(name) => line(d, "name " + head + " " + name),
        ExprNode::Unary(op, operand) => {
            line(d, "unary " + head + " " + op);
            print_expr(src, d + 1, operand);
        }
        ExprNode::Binary(op, left, right) => {
            line(d, "binary " + head + " " + op);
            print_expr(src, d + 1, left);
            print_expr(src, d + 1, right);
        }
        ExprNode::Call(callee, args) => {
            line(d, "call " + head);
            print_expr(src, d + 1, callee);
            print_exprs(src, d + 1, args);
        }
        ExprNode::If(cond, then, els) => {
            line(d, "if-expr " + head);
            print_expr(src, d + 1, cond);
            print_expr(src, d + 1, then);
            print_expr(src, d + 1, els);
        }
        ExprNode::Field(object, field) => {
            line(d, "get " + head + " " + named(field));
            print_expr(src, d + 1, object);
        }
        ExprNode::StructLit(name, fields) => {
            line(d, "struct-lit " + head + " " + named(name));
            for f in fields {
                line(d + 1, ident_node("init", f.name));
                print_expr(src, d + 2, f.value);
            }
        }
        ExprNode::Index(array, index) => {
            line(d, "index " + head);
            print_expr(src, d + 1, array);
            print_expr(src, d + 1, index);
        }
        ExprNode::Try(operand) => {
            line(d, "try " + head);
            print_expr(src, d + 1, operand);
        }
        ExprNode::ArrayLit(elements) => {
            line(d, "array-lit " + head);
            print_exprs(src, d + 1, elements);
        }
        ExprNode::Variant(enum_name, variant, args) => {
            line(d, "variant-lit " + head + " " + named(enum_name) + " " + named(variant));
            print_exprs(src, d + 1, args);
        }
        ExprNode::Match(kw, scrutinee, arms) => {
            line(d, "match-expr " + head + " " + span(kw.start, kw.end));
            print_expr(src, d + 1, scrutinee);
            print_arms(src, d + 1, arms);
        }
    }
}

fn print_block(src: string, d: int, b: Block) {
    line(d, "block " + span(b.start, b.end));
    for s in b.stmts {
        print_stmt(src, d + 1, s);
    }
}

fn print_stmt(src: string, d: int, s: Stmt) {
    let head: string = span(s.start, s.end);
    match s.node {
        StmtNode::Let(mutable, name, ty, init) => {
            var tag: string = "let ";
            if mutable {
                tag = "var ";
            }
            line(d, tag + head + " " + named(name));
            print_type(d + 1, ty);
            print_expr(src, d + 1, init);
        }
        StmtNode::LetElse(pattern, init, _, else_block) => {
            line(d, "let-else " + head);
            print_pattern(d + 1, pattern);
            print_expr(src, d + 1, init);
            print_block(src, d + 1, else_block);
        }
        StmtNode::IfLet(pattern, scrutinee, then, els) => {
            line(d, "if-let " + head);
            print_pattern(d + 1, pattern);
            print_expr(src, d + 1, scrutinee);
            print_block(src, d + 1, then);
            match els {
                Else::None => line(d + 1, "-"),
                Else::Block(b) => print_block(src, d + 1, b),
                Else::If(next) => print_stmt(src, d + 1, next),
                Else::IfLet(next) => print_stmt(src, d + 1, next),
            }
        }
        StmtNode::Assign(op, target, value) => {
            line(d, "assign " + head + " " + op);
            print_expr(src, d + 1, target);
            print_expr(src, d + 1, value);
        }
        StmtNode::If(cond, then, els) => {
            line(d, "if " + head);
            print_expr(src, d + 1, cond);
            print_block(src, d + 1, then);
            match els {
                Else::None => line(d + 1, "-"),
                Else::Block(b) => print_block(src, d + 1, b),
                Else::If(next) => print_stmt(src, d + 1, next),
                Else::IfLet(next) => print_stmt(src, d + 1, next),
            }
        }
        StmtNode::While(cond, body) => {
            line(d, "while " + head);
            print_expr(src, d + 1, cond);
            print_block(src, d + 1, body);
        }
        StmtNode::ForRange(name, start, end, body) => {
            line(d, "for-range " + head + " " + named(name));
            print_expr(src, d + 1, start);
            print_expr(src, d + 1, end);
            print_block(src, d + 1, body);
        }
        StmtNode::ForEach(name, iterable, body) => {
            line(d, "for-each " + head + " " + named(name));
            print_expr(src, d + 1, iterable);
            print_block(src, d + 1, body);
        }
        StmtNode::Match(kw, scrutinee, arms) => {
            line(d, "match " + head + " " + span(kw.start, kw.end));
            print_expr(src, d + 1, scrutinee);
            print_arms(src, d + 1, arms);
        }
        StmtNode::Break => line(d, "break " + head),
        StmtNode::Continue => line(d, "continue " + head),
        StmtNode::Return(value) => {
            line(d, "return " + head);
            match value {
                Option::None => line(d + 1, "-"),
                Option::Some(e) => print_expr(src, d + 1, e),
            }
        }
        StmtNode::Block(b) => print_block(src, d, b),
        StmtNode::Expr(e) => {
            line(d, "expr " + head);
            print_expr(src, d + 1, e);
        }
    }
}

fn print_typed(tag: string, d: int, t: Typed) {
    line(d, ident_node(tag, t.name));
    print_type(d + 1, t.ty);
}

fn print_item(src: string, item: Item) {
    match item {
        Item::Fn(f) => {
            line(0, "fn " + span(f.start, f.end) + " " + named(f.name));
            for param in f.params {
                print_typed("param", 1, param);
            }
            match f.ret {
                Option::None => line(1, "-"),
                Option::Some(ty) => print_type(1, ty),
            }
            print_block(src, 1, f.body);
        }
        Item::Struct(s) => {
            line(0, "struct " + span(s.start, s.end) + " " + named(s.name));
            for field in s.fields {
                print_typed("field", 1, field);
            }
        }
        Item::Import(i) => {
            line(0, "import " + span(i.start, i.end) + " " + substring(src, i.path_start, i.path_end));
        }
        Item::Enum(e) => {
            line(0, "enum " + span(e.start, e.end) + " " + named(e.name));
            for param in e.params {
                line(1, ident_node("type-param", param));
            }
            for v in e.variants {
                line(1, ident_node("variant", v.name));
                for ty in v.payload {
                    print_type(2, ty);
                }
            }
        }
    }
}

fn print_errors(errors: [LexError]) {
    for e in errors {
        eprint("error " + span(e.start, e.end) + " " + e.message);
    }
}

// ---- driver

// Prints `msg` to stderr and exits with status 2, for a usage or read error.
fn die(msg: string): never {
    eprint(msg);
    exit(2);
}

fn main(args: [string]): int {
    if len(args) != 1 {
        die("usage: parse <file>");
    }
    match read_file(args[0]) {
        Result::Ok(src) => {
            let lx: Lexer = lex(src);
            let p: Parser = new_parser(lx);
            for item in parse_program(p) {
                print_item(src, item);
            }
            print_errors(lx.errors);
            print_errors(p.errors);
            if len(lx.errors) + len(p.errors) > 0 {
                return 1;
            }
            return 0;
        }
        Result::Err(msg) => die(msg),
    }
}
