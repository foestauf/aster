// expect-stdout:
// 1
// 2
// Fizz
// 4
// Buzz
// Fizz
// 7
// 8
// Fizz
// Buzz
// 11
// Fizz
// 13
// 14
// FizzBuzz
fn fizzbuzz(n: int): string {
    if n % 15 == 0 {
        return "FizzBuzz";
    }
    if n % 3 == 0 {
        return "Fizz";
    }
    if n % 5 == 0 {
        return "Buzz";
    }
    return int_to_string(n);
}

fn main(): int {
    var i: int = 1;
    while i <= 15 {
        print(fizzbuzz(i));
        i = i + 1;
    }
    return 0;
}
