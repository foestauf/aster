// An arithmetic calculator: a tokenizer over a payload-free Kind enum, a recursive-descent parser that builds an
// Expr tree, and an evaluator and printer written with match.
// expect-stdout:
// 1 + 2 * 3 => (1 + (2 * 3)) = 7
// (1 + 2) * 3 => ((1 + 2) * 3) = 9
// -4 + 10 / 3 => (-4 + (10 / 3)) = -1
// 2 * -(3 - 5) % 3 => ((2 * -(3 - 5)) % 3) = 1
// 100 - 1 - 2 - 3 => (((100 - 1) - 2) - 3) = 94
enum Kind { Num, Plus, Minus, Star, Slash, Percent, LParen, RParen, End }

struct Token { kind: Kind, value: int }

enum Expr {
    Num(int),
    Neg(Expr),
    Binary(Kind, Expr, Expr),
}

struct Parser { tokens: [Token], pos: int }

fn symbol(c: int): Kind {
    if c == 43 { return Kind::Plus; }
    if c == 45 { return Kind::Minus; }
    if c == 42 { return Kind::Star; }
    if c == 47 { return Kind::Slash; }
    if c == 37 { return Kind::Percent; }
    if c == 40 { return Kind::LParen; }
    if c == 41 { return Kind::RParen; }
    panic("unexpected character");
}

fn tokenize(src: string): [Token] {
    let tokens: [Token] = [];
    var i: int = 0;
    while i < len(src) {
        let c: int = byte_at(src, i);
        if c == 32 {
            i += 1;
        } else if c >= 48 && c <= 57 {
            var n: int = 0;
            while i < len(src) && byte_at(src, i) >= 48 && byte_at(src, i) <= 57 {
                n = n * 10 + (byte_at(src, i) - 48);
                i += 1;
            }
            push(tokens, Token { kind: Kind::Num, value: n });
        } else {
            push(tokens, Token { kind: symbol(c), value: 0 });
            i += 1;
        }
    }
    push(tokens, Token { kind: Kind::End, value: 0 });
    return tokens;
}

fn peek(p: Parser): Kind {
    return p.tokens[p.pos].kind;
}

fn advance(p: Parser): Token {
    let t: Token = p.tokens[p.pos];
    p.pos += 1;
    return t;
}

fn expect(p: Parser, k: Kind) {
    if peek(p) != k {
        panic("unexpected token");
    }
    p.pos += 1;
}

fn parse_expr(p: Parser): Expr {
    var left: Expr = parse_term(p);
    while peek(p) == Kind::Plus || peek(p) == Kind::Minus {
        let op: Kind = advance(p).kind;
        left = Expr::Binary(op, left, parse_term(p));
    }
    return left;
}

fn parse_term(p: Parser): Expr {
    var left: Expr = parse_unary(p);
    while peek(p) == Kind::Star || peek(p) == Kind::Slash || peek(p) == Kind::Percent {
        let op: Kind = advance(p).kind;
        left = Expr::Binary(op, left, parse_unary(p));
    }
    return left;
}

fn parse_unary(p: Parser): Expr {
    if peek(p) == Kind::Minus {
        p.pos += 1;
        return Expr::Neg(parse_unary(p));
    }
    return parse_primary(p);
}

fn parse_primary(p: Parser): Expr {
    let t: Token = advance(p);
    if t.kind == Kind::Num {
        return Expr::Num(t.value);
    }
    if t.kind == Kind::LParen {
        let inner: Expr = parse_expr(p);
        expect(p, Kind::RParen);
        return inner;
    }
    panic("expected a number or '('");
}

fn apply(op: Kind, a: int, b: int): int {
    match op {
        Kind::Plus => { return a + b; }
        Kind::Minus => { return a - b; }
        Kind::Star => { return a * b; }
        Kind::Slash => { return a / b; }
        Kind::Percent => { return a % b; }
        _ => panic("not an operator"),
    }
}

fn eval(e: Expr): int {
    return match e {
        Expr::Num(n) => n,
        Expr::Neg(x) => -eval(x),
        Expr::Binary(op, l, r) => apply(op, eval(l), eval(r)),
    };
}

fn op_text(op: Kind): string {
    return match op {
        Kind::Plus => "+",
        Kind::Minus => "-",
        Kind::Star => "*",
        Kind::Slash => "/",
        Kind::Percent => "%",
        _ => "?",
    };
}

fn render(e: Expr): string {
    return match e {
        Expr::Num(n) => int_to_string(n),
        Expr::Neg(x) => "-" + render(x),
        Expr::Binary(op, l, r) => "(" + render(l) + " " + op_text(op) + " " + render(r) + ")",
    };
}

fn calc(src: string) {
    let p: Parser = Parser { tokens: tokenize(src), pos: 0 };
    let e: Expr = parse_expr(p);
    expect(p, Kind::End);
    print(src + " => " + render(e) + " = " + int_to_string(eval(e)));
}

fn main(): int {
    calc("1 + 2 * 3");
    calc("(1 + 2) * 3");
    calc("-4 + 10 / 3");
    calc("2 * -(3 - 5) % 3");
    calc("100 - 1 - 2 - 3");
    return 0;
}
