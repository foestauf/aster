// Int and char matches: negative cases, INT64 extremes, or-patterns, char patterns, expression and statement forms.
// expect-stdout:
// zero
// neg one
// max
// min
// other
// 1
// 1
// 2
// 3
// 20
fn name(n: int): string {
    return match n {
        0 => "zero",
        -1 => "neg one",
        9223372036854775807 => "max",
        -9223372036854775808 => "min",
        _ => "other",
    };
}

fn vowel(s: string, i: int): int {
    return match byte_at(s, i) {
        'a' | 'b' => 1,
        'c' => 2,
        _ => 3,
    };
}

fn main(): int {
    print(name(0));
    print(name(-1));
    print(name(9223372036854775807));
    print(name(-9223372036854775808));
    print(name(5));
    print(vowel("abc", 0));
    print(vowel("abc", 1));
    print(vowel("abc", 2));
    print(vowel("xyz", 0));
    match 7 {
        7 => {
            let x: int = 10;
            print(x * 2);
        }
        _ => {}
    }
    return 0;
}
