// Range loops are half-open, may run zero times, and evaluate their bounds once, start first.
// expect-stdout:
// 0
// 1
// 2
// start
// end
// -2
// -1
// 3
fn t(label: string, v: int): int {
    print(label);
    return v;
}

fn main(): int {
    for i in 0..3 {
        print(i);
    }
    for i in 5..5 {
        print(i);
    }
    for i in 3..0 {
        print(i);
    }
    var total: int = 0;
    for i in t("start", -2)..t("end", 4) {
        if i < 0 {
            print(i);
        }
        total += i;
    }
    print(total);
    return 0;
}
