// The loop variable shadows outer names, and a loop body that always returns or breaks still compiles.
// expect-stdout:
// outer
// 0
// 1
// outer
// 5
// -1
// 7
fn first(xs: [int]): int {
    for x in xs {
        return x;
    }
    return -1;
}

fn first_plus_seven(n: int): int {
    for i in 0..n {
        return i + 7;
    }
    return -1;
}

fn main(): int {
    let i: string = "outer";
    print(i);
    for i in 0..2 {
        print(i);
    }
    print(i);
    print(first([5, 6]));
    print(first([]));
    for x in [1] {
        break;
    }
    print(first_plus_seven(3));
    return 0;
}
