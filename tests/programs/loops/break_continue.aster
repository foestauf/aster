// expect-stdout:
// 1
// 3
// 5
// 10
// 20
// done
fn main(): int {
    for i in 0..100 {
        if i % 2 == 0 {
            continue;
        }
        if i > 5 {
            break;
        }
        print(i);
    }
    for x in [10, 20, 30] {
        if x == 30 {
            break;
        }
        print(x);
    }
    print("done");
    return 0;
}
