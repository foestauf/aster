// expect-stdout:
// true
// true
// false
fn main(): int {
    print(is_even(10));
    print(is_odd(7));
    print(is_odd(4));
    return 0;
}

fn is_even(n: int): bool {
    return if n == 0 { true } else { is_odd(n - 1) };
}

fn is_odd(n: int): bool {
    return if n == 0 { false } else { is_even(n - 1) };
}
