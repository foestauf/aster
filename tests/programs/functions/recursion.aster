// expect-stdout:
// 3628800
// 6765
fn fact(n: int): int {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

fn fib(n: int): int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main(): int {
    print(fact(10));
    print(fib(20));
    return 0;
}
