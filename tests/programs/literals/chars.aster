// expect-stdout:
// 97
// 32
// 126
// 10 9 13 92 39 34 0
// true
// 98
// 7
fn main(): int {
    print('a');
    print(' ');
    print('~');
    print(int_to_string('\n') + " " + int_to_string('\t') + " " + int_to_string('\r') + " " + int_to_string('\\') + " " + int_to_string('\'') + " " + int_to_string('\"') + " " + int_to_string('\0'));
    print(byte_at("xay", 1) == 'a');
    print('a' + 1);
    print('7' - '0');
    return 0;
}
