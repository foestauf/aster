// A linked list built from a struct and an optional-style enum that refer to each other.
// expect-stdout:
// 3
// 2
// 1
// sum 6
struct Node { value: int, next: NodeOpt }
enum NodeOpt { None, Some(Node) }

fn prepend(list: NodeOpt, value: int): NodeOpt {
    return NodeOpt::Some(Node { value: value, next: list });
}

fn main(): int {
    var list: NodeOpt = NodeOpt::None;
    for i in 1..4 {
        list = prepend(list, i);
    }
    var cur: NodeOpt = list;
    var sum: int = 0;
    var done: bool = false;
    while !done {
        match cur {
            NodeOpt::Some(node) => {
                print(node.value);
                sum += node.value;
                cur = node.next;
            }
            NodeOpt::None => { done = true; }
        }
    }
    print("sum " + int_to_string(sum));
    return 0;
}
