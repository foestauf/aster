// expect-stdout:
// fixtures/missing.txt: No such file or directory
// fixtures: Is a directory
// fixtures/a: invalid path
// ok
fn show(r: Result[string, string]) {
    match r {
        Result::Ok(_) => print("ok"),
        Result::Err(e) => print(e),
    }
}

fn main(): int {
    show(read_file("fixtures/missing.txt"));
    show(read_file("fixtures"));
    show(read_file("fixtures/a\0b"));
    show(read_file("fixtures/empty.txt"));
    return 0;
}
