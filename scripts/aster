#!/bin/sh
# `pnpm aster`: runs the installed self-hosted compiler, build/asterc (issue #21). It never falls back to another
# compiler: `pnpm bootstrap` installs the compiler from a release.
bin="$(dirname "$0")/../build/asterc"
if [ ! -x "$bin" ]; then
  echo 'aster: no compiler at build/asterc; run `pnpm bootstrap` first' >&2
  exit 2
fi
exec "$bin" "$@"
